---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import photo from '../assets/juan-mata.png';
import { profile } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role.es}`,
  description = profile.seoDescription.es,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = await getImage({ src: photo, width: 1200, height: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role.es,
  email: `mailto:${profile.email}`,
  url: site.href,
  image: ogImageUrl,
  address: { '@type': 'PostalAddress', addressLocality: 'Caracas', addressCountry: 'VE' },
  sameAs: [profile.github, profile.linkedin],
};
---

<!doctype html>
<html lang="es" data-theme="dark" data-lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#07080c" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Inicialización temprana de Tema & Idioma sin flash visual -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = 'dark';
        var lang = 'es';
        try {
          theme = localStorage.getItem('theme') || 'dark';
          lang = localStorage.getItem('lang') || 'es';
        } catch (e) {}
        root.dataset.theme = theme;
        root.dataset.lang = lang;
        root.lang = lang;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body class="relative min-h-dvh overflow-x-hidden bg-bg text-fg selection:bg-accent selection:text-accent-fg">
    <!-- Capas de textura física estructural que eliminan el fondo plano unicolor -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-50 texture-ambient-light"></div>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-40 texture-grid-mesh opacity-60"></div>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-30 texture-dot-matrix opacity-70"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-xl focus:border focus:border-border focus:bg-surface focus:px-4 focus:py-2.5 focus:text-xs focus:font-bold focus:text-fg focus:shadow-xl"
    >
      <span class="lang-es">Saltar al contenido principal</span>
      <span class="lang-en">Skip to main content</span>
    </a>
    
    <div id="main">
      <slot />
    </div>

    <!-- Script de Reveal progresivo en scroll -->
    <script>
      (function () {
        var elements = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
          );
          elements.forEach(function (el) { observer.observe(el); });
          document.documentElement.classList.add('reveal-ready');
        } else {
          elements.forEach(function (el) { el.classList.add('is-visible'); });
        }
      })();
    </script>
  </body>
</html>
