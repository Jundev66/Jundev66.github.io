        <div class="flex items-center gap-2 font-mono text-xs text-cyan-400 font-semibold tracking-wider">
          <span>CAPACIDADES TÉCNICAS & CREDENCIALES</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl font-black text-white mt-1">
          Ecosistema Tecnológico & Formación
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {skillGroups.map(group => (
          <div class="rounded-2xl border border-white/10 bg-[#0c1018]/90 p-5 space-y-4 shadow-lg hover:border-white/20 transition-colors">
            <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
              <div class="flex items-center gap-2">
                <Icon name={group.icon} class="size-4 text-cyan-400" />
                <h3 class="font-bold text-xs text-white">{group.title}</h3>
              </div>
              <span class="font-mono text-[10px] text-slate-400 px-2 py-0.5 rounded bg-white/5 border border-white/10">
                {group.skills.length}
              </span>
            </div>

            <div class="flex flex-wrap gap-1.5">
              {group.skills.map(s => (
                <SkillChip skill={s} size="sm" />
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        
        <div class="rounded-2xl border border-white/10 bg-[#0c1018]/90 p-6 space-y-3 shadow-md">
          <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs">
            <Icon name="lucide:graduation-cap" class="size-4" />
            <span class="font-bold">EDUCACIÓN SUPERIOR</span>
          </div>
          <h3 class="text-base font-bold text-white">{education.degree.title}</h3>
          <p class="text-xs text-slate-300 font-mono">{education.degree.school} · {education.degree.place}</p>
          <span class="inline-block text-[11px] font-mono text-cyan-300 bg-cyan-500/10 px-2.5 py-1 rounded-full border border-cyan-500/20 font-semibold">
            {education.degree.status}
          </span>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#0c1018]/90 p-6 space-y-3 shadow-md">
          <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs">
            <Icon name="lucide:award" class="size-4" />
            <span class="font-bold">CERTIFICACIONES</span>
          </div>
          {education.certifications.map(c => (
            <div>
              <h3 class="text-base font-bold text-white">{c.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed mt-1">{c.text}</p>
            </div>
          ))}
          <div class="pt-2 flex gap-4 text-xs font-mono text-slate-300">
            <span>Español: <strong class="text-emerald-400">Nativo</strong></span>
            <span>·</span>
            <span>Inglés: <strong class="text-cyan-400">Técnico B2+</strong></span>
          </div>
        </div>

      </div>

    </section>

    <!-- ACT 6: CONTACTO DIRECTO -->
    <section id="act-contact" class="relative px-4 sm:px-8 max-w-7xl mx-auto">
      <div class="rounded-3xl border border-white/15 bg-gradient-to-b from-[#0c1018] to-[#07090e] p-8 sm:p-14 text-center space-y-8 shadow-2xl">
        
        <div class="space-y-3 max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-4 py-1.5 font-mono text-xs font-semibold text-emerald-400">
            <span class="size-2 rounded-full bg-emerald-400 animate-ping"></span>
            DISPONIBILIDAD INMEDIATA · REMOTO O HÍBRIDO
          </span>
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">
            Construyamos software sólido.
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Disponible para unirme de inmediato como Full-Stack, Cloud o QA Engineer a equipos que valoran la mantenibilidad, el testing automatizado y la arquitectura limpia.
          </p>
        </div>

        <!-- Botones de Contacto Sobrios -->
        <div class="flex flex-wrap justify-center gap-3 font-mono text-xs">
          <a href={`mailto:${profile.email}`} class="rounded-xl bg-cyan-500 px-6 py-3.5 font-bold text-slate-950 hover:bg-cyan-400 transition-colors flex items-center gap-2 shadow-lg">
            <Icon name="lucide:mail" class="size-4" />
            <span>{profile.email}</span>
          </a>

          <a href={profile.whatsappUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-3.5 text-emerald-300 font-bold hover:bg-emerald-500/20 transition-colors flex items-center gap-2">
            <Icon name="simple-icons:whatsapp" class="size-4 text-emerald-400" />
            <span>WhatsApp: {profile.whatsapp}</span>
          </a>

          <a href="/juan-mata-cv.pdf" download class="rounded-xl border border-white/15 bg-white/5 px-5 py-3.5 text-white font-bold hover:border-cyan-400 transition-colors flex items-center gap-2">
            <Icon name="lucide:download" class="size-4 text-cyan-400" />
            <span>Descargar CV (PDF)</span>
          </a>

          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-white/15 bg-white/5 px-5 py-3.5 text-slate-200 font-bold hover:border-cyan-400 transition-colors flex items-center gap-2">
            <Icon name="simple-icons:linkedin" class="size-4 text-cyan-400" />
            <span>LinkedIn</span>
          </a>
        </div>

        <div class="text-[11px] font-mono text-slate-400 pt-4 border-t border-white/10">
          Caracas, Venezuela (UTC-4) · Respuestas en menos de 24 horas.
        </div>

      </div>
    </section>

  </main>

  <!-- SCRIPT CLIENTE BUNDLEADO (COMPATIBLE CON CSP 'self', SIN BLOQUEOS DE HASH) -->
  <script>
    function initPortfolio() {
      // 1. Manejo del Modal de Índice en Móvil y Tablet
      const modal = document.getElementById('mobile-index-modal');
      const btnToggleMobile = document.getElementById('btn-toggle-index-mobile');
      const btnFloating = document.getElementById('btn-floating-index');
      const btnClose = document.getElementById('btn-close-mobile-index');

      function openIndex() {
        if (!modal) return;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeIndex() {
        if (!modal) return;
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }

      if (btnToggleMobile) btnToggleMobile.addEventListener('click', openIndex);
      if (btnFloating) btnFloating.addEventListener('click', openIndex);
      if (btnClose) btnClose.addEventListener('click', closeIndex);

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeIndex();
        });
      }

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeIndex();
        }
      });

      // 2. Scroll suave y cierre automático en móvil
      document.querySelectorAll('.mobile-index-link, .nav-index-link').forEach(link => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('data-target');
          if (!targetId) return;
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            e.preventDefault();
            closeIndex();
            const headerOffset = 60;
            const elementPosition = targetEl.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });

      // 3. Scroll Spy: Resaltar la sección activa en el Índice
      const sections = ['act-0', 'act-1', 'act-2', 'act-lab', 'act-3', 'act-4', 'act-contact'];
      const desktopLinks = document.querySelectorAll('.nav-index-link');
      const mobileLinks = document.querySelectorAll('.mobile-index-link');

      function updateActiveSection() {
        const scrollPos = window.scrollY + 120;
        let currentSection = sections[0];

        for (let i = 0; i < sections.length; i++) {
          const el = document.getElementById(sections[i]);
          if (el) {
            const top = el.offsetTop;
            if (scrollPos >= top) {
              currentSection = sections[i];
            }
          }
        }

        desktopLinks.forEach(link => {
          const isCurrent = link.getAttribute('data-target') === currentSection;
          if (isCurrent) {
            link.classList.add('text-white', 'bg-white/10', 'font-bold');
            link.classList.remove('text-slate-400');
          } else {
            link.classList.remove('text-white', 'bg-white/10', 'font-bold');
            link.classList.add('text-slate-400');
          }
        });

        mobileLinks.forEach(link => {
          const isCurrent = link.getAttribute('data-target') === currentSection;
          if (isCurrent) {
            link.classList.add('text-white', 'bg-white/10', 'font-bold');
            link.classList.remove('text-slate-300');
          } else {
            link.classList.remove('text-white', 'bg-white/10', 'font-bold');
            link.classList.add('text-slate-300');
          }
        });
      }

      window.addEventListener('scroll', updateActiveSection, { passive: true });
      updateActiveSection();

      // 4. CONMUTADOR DE ADRs EN 2 COLUMNAS (100% ROBUSTO & ACCESIBLE)
      const adrButtons = document.querySelectorAll<HTMLButtonElement>('[data-adr-btn]');
      const adrViews = document.querySelectorAll<HTMLElement>('[data-adr-view]');

      function selectAdr(targetIdx: number) {
        adrButtons.forEach((btn, idx) => {
          const isActive = idx === targetIdx;
          btn.setAttribute('aria-selected', String(isActive));
          if (isActive) {
            btn.classList.add('is-active', 'border-cyan-400', 'bg-cyan-950/60', 'text-white', 'shadow-[0_0_25px_-5px_rgba(6,182,212,0.35)]');
            btn.classList.remove('border-white/10', 'bg-[#0c1018]/80', 'text-zinc-300');
          } else {
            btn.classList.remove('is-active', 'border-cyan-400', 'bg-cyan-950/60', 'text-white', 'shadow-[0_0_25px_-5px_rgba(6,182,212,0.35)]');
            btn.classList.add('border-white/10', 'bg-[#0c1018]/80', 'text-zinc-300');
          }
        });

        adrViews.forEach((view, idx) => {
          if (idx === targetIdx) {
            view.classList.remove('hidden');
          } else {
            view.classList.add('hidden');
          }
        });

        // En pantallas móviles / tablet (<1024px), desplazar al panel inspector para feedback visual inmediato
        if (window.innerWidth < 1024) {
          const inspectorBox = document.getElementById('adr-inspector-box');
          if (inspectorBox) {
            inspectorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      }

      adrButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
          selectAdr(idx);
        });
      });

      // Delegación de eventos en el contenedor de ADRs como respaldo infalible
      const actLab = document.getElementById('act-lab');
      if (actLab) {
        actLab.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const closestBtn = target.closest('[data-adr-btn]');
          if (closestBtn) {
            e.preventDefault();
            const idx = parseInt(closestBtn.getAttribute('data-index') || '0', 10);
            selectAdr(idx);
          }
        });
      }
    }

    // Inicialización inmediata y en eventos del ciclo de vida
    initPortfolio();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPortfolio);
    }
    document.addEventListener('astro:page-load', initPortfolio);
  </script>
</Layout>
