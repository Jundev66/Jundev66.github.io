---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import SkillChip from '../components/SkillChip.astro';
import { profile, about, projects, experience, skillGroups, education } from '../data/cv';
import juanPhoto from '../assets/juan-mata.png';
import corebizApp from '../assets/projects/corebiz-app.png';
import cryotechReports from '../assets/projects/cryotech-reports.png';

const corebizProject = projects.find(p => p.name === 'CoreBiz') || projects[0];
const cryotechProject = projects.find(p => p.name === 'CryoTech') || projects[2];
const komboProject = projects.find(p => p.name === 'Kombo') || projects[1];

const adrs = [
  {
    id: 'adr-01',
    num: 'ADR-001',
    title: 'Control de Costes en IA: Pipeline Híbrido OCR + LLM',
    system: 'CryoTech AI (Telegram Bot + Claude API)',
    badge: 'INGENIERÍA FINANCIERA & IA',
    summary: 'Reducción de más de un 80% en la factura de la API de Anthropic y latencia <400ms al no enviar imágenes ciegas al LLM.',
    context: 'Procesar miles de comprobantes fiscales y bancarios enviando cada foto directamente a Claude Vision genera facturas elevadas de tokens mensuales y latencias de 3 a 5 segundos por comprobante.',
    decision: 'Implementamos un pipeline híbrido en dos fases:\n1. Nivel 1 ($0 Coste): Tesseract.js normaliza el contraste y extrae texto en 300ms a costo cero. Si el comprobante es nítido y contiene los campos contables, se liquida de inmediato.\n2. Nivel 2 (Inferencia Asistida): Solo si el comprobante está arrugado, doblado, manuscrito o le faltan datos críticos, se activa Claude Vision con extracción estructurada en JSON estricto.\n3. Protección de presupuesto: Circuit breaker con límite de tasa para evitar bucles o picos de consumo inesperados.',
    tradeoffs: 'Requiere mantener dos motores de parsing y normalización, compensado ampliamente por un ahorro del 80%+ en costes de tokens y respuesta casi instantánea.',
    metrics: [
      { label: 'Ahorro Factura API', val: '>80%' },
      { label: 'Latencia P50 Comprobantes', val: '<400ms' },
      { label: 'Precisión en Asientos', val: '99.8%' }
    ],
    actionText: 'Ver Repositorio CryoTech ↗',
    actionUrl: 'https://github.com/Jundev66/cryotech'
  },
  {
    id: 'adr-02',
    num: 'ADR-002',
    title: 'Aislamiento Multi-Tenant a 4 Capas con PostgreSQL RLS',
    system: 'CoreBiz Multi-Tenant ERP',
    badge: 'SEGURIDAD CRÍTICA',
    summary: 'Garantía matemática de cero filtraciones entre empresas competidoras, delegando la seguridad al motor de PostgreSQL.',
    context: 'En SaaS B2B, confiar en cláusulas WHERE manuales en el backend (ej: WHERE tenant_id = x) es una vulnerabilidad latente: un solo descuido de un desarrollador expone registros confidenciales a la competencia.',
    decision: 'Blindamos el aislamiento a 4 capas:\n1. Capa de Red: Enrutamiento y validación de subdominio dinámico en middleware de borde.\n2. Capa de Sesión: Inyección estricta del tenant_id en el JWT verificado por Supabase Auth.\n3. Capa de Base de Datos: Políticas de Row Level Security (RLS) en PostgreSQL tabla por tabla. Cualquier consulta SQL sin tenant es rechazada por el propio motor de la base de datos.\n4. Capa de Testing: Matriz de 497 tests con suites de ataque cruzado (cross-tenant leakage tests) en CI.',
    tradeoffs: 'Migraciones SQL más elaboradas y tests obligatorios de seguridad en cada PR, eliminando por completo el riesgo de filtración de datos entre clientes.',
    metrics: [
      { label: 'Tablas con RLS', val: '28 Tablas' },
      { label: 'Fugas Registradas', val: '0 Fugas' },
      { label: 'Aislamiento en CI', val: '100% Pass' }
    ],
    actionText: 'Abrir CoreBiz en Producción ↗',
    actionUrl: 'https://corebiz-web.vercel.app'
  },
  {
    id: 'adr-03',
    num: 'ADR-003',
    title: 'Arquitectura Hexagonal & DDD Táctico con Core Desacoplado',
    system: 'Medine.tech & CoreBiz',
    badge: 'ARQUITECTURA LIMPIA',
    summary: 'Reglas de negocio (nómina, compras, facturación) 100% libres de dependencias de frameworks y ORMs.',
    context: 'Los monolitos empresariales se degradan cuando las reglas de negocio quedan acopladas a controladores de Laravel/NestJS o llamadas a Eloquent/Prisma. Cambiar de framework o refactorizar se vuelve prohibitivo.',
    decision: 'Estructuramos el sistema con Arquitectura Hexagonal y Domain-Driven Design:\n1. Núcleo de Dominio puro en TypeScript/PHP, sin bibliotecas de infraestructura.\n2. Puertos e interfaces explícitos para repositorios, colas de mensajería (RabbitMQ) y pasarelas de pago.\n3. Adaptadores desacoplados que conectan la infraestructura con el dominio.\n4. Linters y CI que rechazan cualquier PR que intente importar dependencias externas en la carpeta `/domain`.',
    tradeoffs: 'Mayor rigor inicial y cantidad de clases DTO, permitiendo refactorizaciones masivas y modernización de código sin riesgo de romper la lógica contable.',
    metrics: [
      { label: 'Deps en Dominio', val: '0 Libs' },
      { label: 'Tests Unitarios', val: '<0.5s' },
      { label: 'Módulos Desacoplados', val: '5 Dominios' }
    ],
    actionText: 'Ver Repositorio CoreBiz ↗',
    actionUrl: 'https://github.com/Jundev66/CoreBiz'
  },
  {
    id: 'adr-04',
    num: 'ADR-004',
    title: 'Pirámide de Pruebas Automatizadas con +500 Tests y OWASP',
    system: 'Medine.tech & CoreBiz',
    badge: 'CALIDAD & CI/CD',
    summary: 'Releases continuos en entornos Linux sin regresiones en flujos de facturación ni pasarelas de pago.',
    context: 'En un ERP con nóminas, facturación electrónica y compras, un bug en producción paraliza operaciones corporativas. Las pruebas manuales son lentas, costosas y propensas al error.',
    decision: 'Diseñamos una estrategia integral de aseguramiento de calidad en GitHub Actions:\n1. Pruebas Unitarias Rápidas: Vitest y PHPUnit para validar reglas aritméticas y entidades contables.\n2. Pruebas de Comportamiento: Behat (ATDD/BDD) para validar escenarios de negocio con especificaciones legibles.\n3. Pruebas E2E: Playwright con Page Object Model (POM) cubriendo flujos de navegación completos y pasarelas de pago.\n4. Seguridad Continua: Escaneos de vulnerabilidades con OWASP ZAP (inyección SQL, headers de Nginx, dependencias).',
    tradeoffs: 'Mantenimiento activo de la suite en integración continua, garantizando releases estables con cero caídas en producción.',
    metrics: [
      { label: 'Tests en CI', val: '+500 Tests' },
      { label: 'Flujos Críticos', val: '100% Cobertura' },
      { label: 'Hallazgos Críticos', val: '0 Fallos' }
    ],
    actionText: 'Ver Matriz de Tests ↗',
    actionUrl: 'https://github.com/Jundev66/CoreBiz'
  }
];
---

<Layout title="Juan Mata — Desarrollador Full-Stack, Cloud & QA | Portafolio">
  
  <!-- BARRA SUPERIOR ELEGANTE -->
  <header class="sticky top-0 z-50 border-b border-white/10 bg-[#07090e]/95 px-4 py-2.5 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between text-xs font-mono">
      <div class="flex items-center gap-2.5">
        <span class="size-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span class="font-bold text-white tracking-wider">JUAN MATA // SOFTWARE ENGINEER</span>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Botón Índice exclusivo para Móvil/Tablet en Header -->
        <button
          type="button"
          id="btn-toggle-index-mobile"
          class="xl:hidden inline-flex items-center gap-1.5 rounded-lg border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-cyan-300 font-bold hover:bg-cyan-500/20 transition-all cursor-pointer"
        >
          <Icon name="lucide:list" class="size-3.5 text-cyan-400" />
          <span>Índice</span>
        </button>

        <a href="/juan-mata-cv.pdf" download class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-2.5 py-1 text-slate-200 font-semibold hover:border-cyan-400 hover:text-white transition-all">
          <Icon name="lucide:download" class="size-3 text-cyan-400" />
          <span>Descargar CV</span>
        </a>

        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-slate-300 hover:border-cyan-400 hover:text-cyan-300 transition-colors">
          <Icon name="simple-icons:github" class="size-3 text-cyan-400" />
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </header>

  <!-- 1. ÍNDICE EN DESKTOP (FLOTANTE LATERAL DERECHO) -->
  <aside 
    id="desktop-index"
    class="hidden xl:flex fixed right-6 top-1/2 -translate-y-1/2 z-40 flex-col gap-1 font-mono text-[10px] bg-[#0c1018]/90 p-3 rounded-2xl border border-white/10 backdrop-blur-xl shadow-2xl w-44"
  >
    <div class="flex items-center justify-between px-2 py-1 border-b border-white/10 mb-1">
      <span class="text-cyan-400 font-bold tracking-wider">ÍNDICE</span>
      <span class="size-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
    </div>
    
    <a href="#act-0" data-target="act-0" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">00. Perfil & Bio</span>
    </a>
    <a href="#act-1" data-target="act-1" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">01. CoreBiz ERP</span>
    </a>
    <a href="#act-2" data-target="act-2" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">02. CryoTech / Kombo</span>
    </a>
    <a href="#act-lab" data-target="act-lab" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">03. Decisiones ADRs</span>
    </a>
    <a href="#act-3" data-target="act-3" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">04. 4 Años Medine</span>
    </a>
    <a href="#act-4" data-target="act-4" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">05. Stack & Radar</span>
    </a>
    <a href="#act-contact" data-target="act-contact" class="nav-index-link text-slate-400 hover:text-white transition-colors flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/5">
      <span class="size-1.5 rounded-full bg-cyan-400 shrink-0"></span>
      <span class="truncate">06. Contacto</span>
    </a>
  </aside>

  <!-- 2. BOTÓN FLOTANTE INFERIOR DE ÍNDICE (PARA MÓVIL Y TABLET) -->
  <div class="xl:hidden fixed bottom-5 right-5 z-40">
    <button
      type="button"
      id="btn-floating-index"
      class="flex items-center gap-2 rounded-full border border-cyan-500/40 bg-[#0c1018]/95 px-4 py-2.5 font-mono text-xs font-bold text-cyan-300 shadow-2xl backdrop-blur-xl cursor-pointer hover:bg-cyan-500/20 active:scale-95 transition-all"
    >
      <Icon name="lucide:list" class="size-4 text-cyan-400" />
      <span>ÍNDICE</span>
    </button>
  </div>

  <!-- 3. MODAL RESPONSIVE DE ÍNDICE (MÓVIL Y TABLET) -->
  <div
    id="mobile-index-modal"
    class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md xl:hidden transition-opacity duration-300"
  >
    <div 
      class="fixed inset-x-4 bottom-6 top-auto sm:inset-x-auto sm:right-6 sm:w-80 rounded-3xl border border-white/15 bg-[#0c1018]/98 p-6 shadow-2xl backdrop-blur-2xl font-mono text-xs"
    >
      <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span class="font-bold text-white tracking-wider text-sm">ÍNDICE</span>
        </div>
        <button
          type="button"
          id="btn-close-mobile-index"
          class="rounded-lg border border-white/10 bg-white/5 p-1.5 text-slate-400 hover:text-white hover:bg-white/10 transition-colors"
        >
          <Icon name="lucide:x" class="size-4" />
        </button>
      </div>

      <div class="space-y-1.5" id="mobile-index-links">
        <a href="#act-0" data-target="act-0" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">00. Perfil & Bio</span>
          </div>
          <span class="text-[10px] text-slate-500">Intro</span>
        </a>

        <a href="#act-1" data-target="act-1" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">01. CoreBiz ERP</span>
          </div>
          <span class="text-[10px] text-slate-400">SaaS</span>
        </a>

        <a href="#act-2" data-target="act-2" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">02. CryoTech & Kombo</span>
          </div>
          <span class="text-[10px] text-slate-400">IA / Eventos</span>
        </a>

        <a href="#act-lab" data-target="act-lab" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">03. Decisiones ADRs</span>
          </div>
          <span class="text-[10px] text-slate-400">Arquitectura</span>
        </a>

        <a href="#act-3" data-target="act-3" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">04. 4 Años Medine</span>
          </div>
          <span class="text-[10px] text-slate-400">Empresa</span>
        </a>

        <a href="#act-4" data-target="act-4" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">05. Stack & Radar</span>
          </div>
          <span class="text-[10px] text-slate-400">Skills</span>
        </a>

        <a href="#act-contact" data-target="act-contact" class="mobile-index-link flex items-center justify-between p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <div class="flex items-center gap-2.5">
            <span class="size-2 rounded-full bg-cyan-400"></span>
            <span class="font-bold">06. Contacto</span>
          </div>
          <span class="text-[10px] text-slate-400">Directo</span>
        </a>
      </div>
    </div>
  </div>

  <main class="space-y-28 sm:space-y-36 pb-28 overflow-x-hidden relative">
    
    <!-- LUZ AMBIENTAL ELEGANTE Y SUTIL -->
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 -z-10 h-[500px] w-[800px] rounded-full bg-cyan-600/8 blur-[160px]"></div>

    <!-- ACT 0: PERFIL & MANIFIESTO DEL INGENIERO -->
    <section id="act-0" class="relative min-h-[80vh] flex flex-col justify-center px-4 sm:px-8 max-w-7xl mx-auto pt-8">
      <div class="space-y-8">
        
        <!-- Status Badges Sobrios -->
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 font-semibold text-emerald-400">
            <span class="size-2 rounded-full bg-emerald-400 animate-ping"></span>
            DISPONIBILIDAD INMEDIATA (REMOTO O HÍBRIDO)
          </span>
          <span class="text-slate-600">·</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-3.5 py-1 text-slate-300 font-semibold">
            EX-MEDINE.TECH (2022–2026 · 4 AÑOS DE TRAYECTORIA)
          </span>
        </div>

        <!-- Headline Limpio y Contundente -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] max-w-5xl">
          Ingeniería de software empresarial: <span class="text-cyan-400">arquitecturas limpias, multi-tenant</span> y +500 pruebas automatizadas.
        </h1>

        <!-- Profile Bar: Foto 1:1, Bio y Métricas Clave -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-4 items-center">
          
          <!-- Foto 1:1 y datos de identidad -->
          <div class="lg:col-span-5 flex items-center gap-5 p-5 rounded-2xl border border-white/10 bg-[#0c1018]/90 shadow-xl backdrop-blur-md">
            <div class="relative size-28 sm:size-32 rounded-2xl overflow-hidden border border-white/20 shadow-2xl shrink-0 bg-[#121624]">
              <Image 
                src={juanPhoto} 
                alt="Juan Mata" 
                width={250} 
                height={250} 
                class="h-full w-full object-cover object-center" 
                priority
              />
              <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-2xl pointer-events-none"></div>
            </div>
            
            <div class="space-y-1.5">
              <div class="text-xl font-bold font-display text-white">{profile.name}</div>
              <div class="text-xs font-mono text-cyan-400 font-semibold">{profile.role}</div>
              <div class="text-xs text-slate-300 font-mono flex items-center gap-1.5">
                <Icon name="lucide:map-pin" class="size-3 text-cyan-400" />
                <span>{profile.location} (UTC-4)</span>
              </div>
              <div class="pt-2 flex flex-wrap gap-1.5">
                <a href={profile.github} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/10 bg-white/5 p-1.5 text-slate-300 hover:text-white hover:border-cyan-400 transition-colors" title="GitHub">
                  <Icon name="simple-icons:github" class="size-3.5" />
                </a>
                <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/10 bg-white/5 p-1.5 text-slate-300 hover:text-white hover:border-cyan-400 transition-colors" title="LinkedIn">
                  <Icon name="simple-icons:linkedin" class="size-3.5" />
                </a>
                <a href={profile.whatsappUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/10 bg-white/5 p-1.5 text-slate-300 hover:text-white hover:border-cyan-400 transition-colors" title="WhatsApp">
                  <Icon name="simple-icons:whatsapp" class="size-3.5 text-emerald-400" />
                </a>
                <a href={`mailto:${profile.email}`} class="rounded-lg border border-white/10 bg-white/5 p-1.5 text-slate-300 hover:text-white hover:border-cyan-400 transition-colors" title="Email">
                  <Icon name="lucide:mail" class="size-3.5" />
                </a>
              </div>
            </div>
          </div>

          <!-- Métricas de Impacto Numérico -->
          <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono">
            {about.stats.map(s => (
              <div class="rounded-2xl border border-white/10 bg-[#0c1018]/70 p-4 text-center sm:text-left space-y-1 shadow-lg hover:border-white/20 transition-colors">
                <div class="text-2xl sm:text-3xl font-extrabold text-cyan-400">{s.value}</div>
                <div class="text-[11px] text-slate-300 font-medium leading-tight">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Manifiesto Narrativo de Juan -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
          {about.highlights.map(h => (
            <div class="rounded-2xl border border-white/10 bg-[#0c1018]/80 p-5 space-y-2.5 hover:border-cyan-500/40 transition-colors shadow-lg">
              <div class="flex items-center gap-2 text-cyan-400">
                <Icon name={h.icon} class="size-4" />
                <h3 class="font-bold text-sm text-white">{h.title}</h3>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">{h.text}</p>
            </div>
          ))}
        </div>

        <!-- Botones de Acción Sobrios -->
        <div class="flex flex-wrap gap-3 font-mono text-xs pt-2">
          <a href="#act-1" class="rounded-xl bg-cyan-500 px-6 py-3 font-bold text-slate-950 hover:bg-cyan-400 transition-colors flex items-center gap-2">
            <span>Explorar Casos de Estudio</span>
            <span>↓</span>
          </a>
          <a href="/juan-mata-cv.pdf" download class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-white hover:border-cyan-400 transition-colors flex items-center gap-2">
            <Icon name="lucide:file-text" class="size-4 text-cyan-400" />
            <span>Descargar CV Completo (PDF)</span>
          </a>
          <a href={profile.whatsappUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-3 text-emerald-400 hover:bg-emerald-500/20 transition-colors flex items-center gap-2">
            <Icon name="simple-icons:whatsapp" class="size-4" />
            <span>WhatsApp Directo</span>
          </a>
        </div>

      </div>
    </section>

    <!-- ACT 1: COREBIZ — SAAS MULTI-TENANT (COMPACTO & ELEGANTE) -->
    <section id="act-1" class="relative px-4 sm:px-8 max-w-7xl mx-auto space-y-8">
      
      <div class="border-b border-white/10 pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
