---
import { Icon } from 'astro-icon/components';
import { nav, profile } from '../data/cv';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Principal">
    <a href="#inicio" class="flex items-center gap-2.5 font-display font-semibold tracking-tight">
      <span
        class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-[var(--btn-from)] to-[var(--btn-to)] text-sm font-bold text-white shadow-lg shadow-[var(--glow)]"
      >
        {profile.initials}
      </span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-nav-link={item.id}
              class="rounded-full px-3.5 py-2 text-sm text-muted transition-colors hover:text-fg data-[active=true]:bg-surface-2 data-[active=true]:text-fg"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button type="button" id="theme-toggle" class="icon-btn size-10" aria-label="Cambiar entre tema claro y oscuro">
        <Icon name="lucide:sun" class="hidden size-[18px] dark:block" />
        <Icon name="lucide:moon" class="block size-[18px] dark:hidden" />
      </button>
      <a href={profile.cv} download class="btn btn-primary hidden !px-4 !py-2 text-sm sm:inline-flex">
        <Icon name="lucide:download" class="size-4" />
        CV
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="icon-btn size-10 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" class="size-5" data-icon-open />
        <Icon name="lucide:x" class="hidden size-5" data-icon-close />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="border-t border-line bg-bg/95 backdrop-blur-xl lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl px-5 py-3 sm:px-8">
      {
        nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="flex items-center justify-between rounded-xl px-3 py-3 text-base text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            >
              {item.label}
              <Icon name="lucide:arrow-right" class="size-4 opacity-50" />
            </a>
          </li>
        ))
      }
      <li class="mt-2 sm:hidden">
        <a href={profile.cv} download class="btn btn-primary w-full justify-center">
          <Icon name="lucide:download" class="size-4" />
          Descargar CV
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const menuButton = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenuOpen = (open: boolean) => {
    menu.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menuButton.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    menuButton.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    if (open) header.classList.add('is-scrolled');
    else onScroll();
  };
  menuButton.addEventListener('click', () => setMenuOpen(menu.hidden));
  menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu.hidden) setMenuOpen(false);
  });

  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = [...links]
    .map((link) => document.getElementById(link.dataset.navLink!))
    .filter((section): section is HTMLElement => section !== null);
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => (link.dataset.active = String(link.dataset.navLink === entry.target.id)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => spy.observe(section));
</script>
