---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { experience } from '../data/cv';

const job = experience[0];
---

<Section
  id="experiencia"
  eyebrow={{ es: 'Track Record Corporativo', en: 'Corporate Track Record' }}
  title={{ es: '4 Años de Trayectoria (Ex-Medine.tech)', en: '4-Year Track Record (Ex-Medine.tech)' }}
  subtitle={{
    es: 'Desarrollo, aseguramiento de calidad (QA) y despliegue en entornos de alta exigencia para clientes empresariales en Latinoamérica.',
    en: 'Software development, automated QA, and Linux production operations for corporate clients across Latin America.',
  }}
>
  <article data-reveal class="card-editorial p-6 sm:p-8 lg:p-10 space-y-8">
    
    <!-- Encabezado de la Empresa & Rol -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-6">
      <div class="flex items-center gap-4">
        <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-border bg-surface-muted text-accent shadow-xs">
          <Icon name="lucide:briefcase" class="size-5" />
        </span>
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <h3 class="font-display text-xl font-bold text-fg sm:text-2xl">
              <span class="lang-es">{job.role.es}</span>
              <span class="lang-en">{job.role.en}</span>
            </h3>
            <span class="rounded-full border border-border bg-surface-muted px-2.5 py-0.5 text-xs font-semibold text-muted">
              <span class="lang-es">{job.duration.es}</span>
              <span class="lang-en">{job.duration.en}</span>
            </span>
          </div>

          <p class="mt-1 text-xs text-muted flex items-center gap-1.5 font-medium">
            <a
              href={job.companyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-fg hover:text-accent transition-colors inline-flex items-center gap-1"
            >
              <span>{job.company}</span>
              <Icon name="lucide:arrow-up-right" class="size-3" />
            </a>
            <span>·</span>
            <span>
              <span class="lang-es">{job.description.es}</span>
              <span class="lang-en">{job.description.en}</span>
            </span>
          </p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-2 text-xs font-medium">
        <span class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface-muted px-2.5 py-1 text-fg">
          <Icon name="lucide:calendar" class="size-3.5 text-accent" />
          <span>{job.period}</span>
        </span>
        <span class="rounded-lg border border-border bg-surface-muted px-2.5 py-1 text-muted">
          <span class="lang-es">{job.mode.es}</span>
          <span class="lang-en">{job.mode.en}</span>
        </span>
      </div>
    </header>

    <!-- 3 Bloques de Responsabilidad Técnica -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {job.groups.map((group) => (
        <div class="card-editorial !rounded-xl p-5 space-y-4 bg-surface-muted/50 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-2 text-xs font-bold text-fg uppercase tracking-wider border-b border-border pb-3">
              <Icon name={group.icon} class="size-4 text-accent" />
              <span>
                <span class="lang-es">{group.title.es}</span>
                <span class="lang-en">{group.title.en}</span>
              </span>
            </div>

            <div class="space-y-3.5">
              {group.items.map((item) => (
                <div class="space-y-1">
                  <h4 class="font-display text-xs font-bold text-fg">
                    <span class="lang-es">{item.title.es}</span>
                    <span class="lang-en">{item.title.en}</span>
                  </h4>
                  <p class="text-xs text-muted leading-relaxed font-medium">
                    <span class="lang-es">{item.text.es}</span>
                    <span class="lang-en">{item.text.en}</span>
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Stack Tecnológico en Medine.tech -->
    <div class="pt-6 border-t border-border space-y-3">
      <span class="block text-xs font-semibold text-muted uppercase tracking-wider">
        <span class="lang-es">Tecnologías aplicadas en producción en Medine.tech:</span>
        <span class="lang-en">Production technologies utilized at Medine.tech:</span>
      </span>
      <ul class="flex flex-wrap gap-1.5">
        {job.stack.map((s) => (
          <SkillChip skill={s} size="sm" />
        ))}
      </ul>
    </div>

  </article>
</Section>
