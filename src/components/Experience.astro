---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { experience } from '../data/cv';
---

<Section
  id="experiencia"
  eyebrow="Trayectoria"
  title="Experiencia profesional"
  subtitle="Construcción, despliegue y aseguramiento de calidad de plataformas B2B de alta demanda en entornos ágiles."
>
  <div class="space-y-8">
    {experience.map((job) => (
      <article data-reveal class="glass-card glow-border overflow-hidden p-6 sm:p-8 shadow-xl">
        <!-- Encabezado del Puesto -->
        <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-line pb-6">
          <div class="flex items-center gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl border border-line bg-surface text-accent shadow-md">
              <Icon name="lucide:briefcase" class="size-6 text-blue-500 dark:text-sky-400" />
            </span>
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-display text-xl font-bold text-fg sm:text-2xl">{job.role}</h3>
                <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-0.5 font-mono text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                  {job.duration}
                </span>
              </div>
              <p class="mt-1 text-xs text-muted flex items-center gap-2">
                <a
                  href={job.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-semibold text-fg hover:text-accent transition-colors"
                >
                  <span>{job.company}</span>
                  <Icon name="lucide:arrow-up-right" class="size-3" />
                </a>
                <span>·</span>
                <span>{job.description}</span>
              </p>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-2 font-mono text-xs">
            <span class="inline-flex items-center gap-1.5 rounded-xl border border-line bg-surface px-3 py-1.5 text-fg shadow-2xs">
              <Icon name="lucide:calendar" class="size-3.5 text-accent" />
              {job.period}
            </span>
            <span class="rounded-xl border border-line bg-surface px-3 py-1.5 text-muted shadow-2xs">
              {job.mode}
            </span>
          </div>
        </header>

        <!-- Bloques de Logros Técnicos -->
        <div class="mt-6 space-y-6">
          {job.groups.map((group) => (
            <div>
              <h4 class="mb-3 flex items-center gap-2 font-mono text-xs font-bold text-fg uppercase tracking-wider">
                <Icon name={group.icon} class="size-4 text-accent" />
                <span>{group.title}</span>
              </h4>
              
              <div class="grid gap-3 md:grid-cols-3">
                {group.items.map((item) => (
                  <div class="rounded-xl border border-line bg-surface-2/40 p-4 transition-all hover:bg-surface-2/80 hover:border-line-strong flex flex-col justify-between">
                    <div>
                      <p class="font-display text-xs font-bold text-fg flex items-start gap-2">
                        <Icon name="lucide:check-circle-2" class="size-3.5 shrink-0 text-emerald-500 mt-0.5" />
                        <span>{item.title}</span>
                      </p>
                      <p class="mt-2 text-xs leading-relaxed text-muted">{item.text}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}

          <!-- Stack de Tecnologías Utilizadas en Puesto -->
          <div class="border-t border-line pt-6">
            <div class="flex items-center justify-between mb-3 font-mono text-xs text-muted">
              <span class="font-bold uppercase tracking-wider flex items-center gap-1.5">
                <Icon name="lucide:terminal" class="size-3.5 text-accent" />
                Tecnologías y herramientas clave en producción:
              </span>
              <span>{job.stack.length} tecnologías</span>
            </div>
            <ul class="flex flex-wrap gap-2">
              {job.stack.map((skill) => (
                <SkillChip skill={skill} size="md" />
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>
