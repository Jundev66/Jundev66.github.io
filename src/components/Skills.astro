---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { skillGroups } from '../data/cv';
---

<Section
  id="habilidades"
  eyebrow="Ecosistema & Stack"
  title="Matriz de capacidades técnicas"
  subtitle="Stack de producción para construir, desplegar, monitorear y gestionar plataformas de software de misión crítica."
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {skillGroups.map((group, i) => (
      <article
        data-reveal
        style={`--d: ${i * 40}ms`}
        class:list={[
          'glass-card p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1',
          group.wide && 'sm:col-span-2 lg:col-span-1'
        ]}
      >
        <div>
          <header class="mb-4 flex items-center justify-between gap-3 border-b border-line pb-3">
            <div class="flex items-center gap-2.5">
              <span class="grid size-8 place-items-center rounded-xl border border-line bg-surface-2 text-accent shadow-2xs">
                <Icon name={group.icon} class="size-4" />
              </span>
              <h3 class="font-display text-sm font-bold text-fg">
                {group.title}
              </h3>
            </div>

            <div class="flex items-center gap-1.5 font-mono text-[10px]">
              {group.badge && (
                <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 text-muted">
                  {group.badge}
                </span>
              )}
              <span class="rounded-md border border-line bg-surface-2 px-1.5 py-0.5 text-muted">
                {group.skills.length}
              </span>
            </div>
          </header>

          <ul class="flex flex-wrap gap-1.5">
            {group.skills.map((skill) => (
              <SkillChip skill={skill} size="sm" />
            ))}
          </ul>
        </div>

        <div class="mt-4 pt-3 border-t border-line/60 flex items-center justify-between text-[11px] font-mono text-muted">
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            Uso en producción
          </span>
        </div>
      </article>
    ))}
  </div>
</Section>
