---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  class?: string;
}

const { id, eyebrow, title, subtitle, class: className } = Astro.props;
---

<section id={id} class:list={['relative py-20 sm:py-28', className]}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <header data-reveal class="mb-12 max-w-2xl sm:mb-14">
      <p class="flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-accent uppercase">
        <span class="h-px w-8 bg-gradient-to-r from-accent to-transparent"></span>
        {eyebrow}
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      {subtitle && <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{subtitle}</p>}
    </header>
    <slot />
  </div>
</section>
