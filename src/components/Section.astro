---
type Localized = { es: string; en: string } | string;

interface Props {
  id: string;
  eyebrow?: Localized;
  title: Localized;
  subtitle?: Localized;
  class?: string;
}

const { id, eyebrow, title, subtitle, class: className } = Astro.props;

const isObj = (val: unknown): val is { es: string; en: string } =>
  typeof val === 'object' && val !== null && 'es' in val && 'en' in val;
---

<section id={id} class:list={['relative py-16 sm:py-24 border-t border-border/40', className]}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header data-reveal class="mb-10 sm:mb-14 max-w-3xl">
      {
        eyebrow && (
          <p class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-accent uppercase mb-2">
            <span class="size-1.5 rounded-full bg-accent" />
            {isObj(eyebrow) ? (
              <>
                <span class="lang-es">{eyebrow.es}</span>
                <span class="lang-en">{eyebrow.en}</span>
              </>
            ) : (
              <span>{eyebrow}</span>
            )}
          </p>
        )
      }
      <h2 class="font-display text-2xl font-bold tracking-tight text-fg sm:text-3xl lg:text-4xl">
        {
          isObj(title) ? (
            <>
              <span class="lang-es">{title.es}</span>
              <span class="lang-en">{title.en}</span>
            </>
          ) : (
            <span>{title}</span>
          )
        }
      </h2>
      {
        subtitle && (
          <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
            {isObj(subtitle) ? (
              <>
                <span class="lang-es">{subtitle.es}</span>
                <span class="lang-en">{subtitle.en}</span>
              </>
            ) : (
              <span>{subtitle}</span>
            )}
          </p>
        )
      }
    </header>
    <slot />
  </div>
</section>
