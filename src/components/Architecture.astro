---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { adrs } from '../data/cv';
---

<Section
  id="arquitectura"
  eyebrow={{ es: 'Criterio Técnico & Finanzas', en: 'Technical Decisions & Trade-offs' }}
  title={{ es: 'Decisiones de Arquitectura (ADRs)', en: 'Architecture Decision Records (ADRs)' }}
  subtitle={{
    es: 'Un sistema robusto se demuestra en cómo se resuelven los trade-offs de negocio, costes de inferencia de IA y seguridad de datos.',
    en: 'Robust software is proven by how business trade-offs, AI inference costs, and data isolation are solved.',
  }}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- COLUMNA IZQUIERDA: SELECTORES DE ADRs (5 cols) -->
    <div class="lg:col-span-5 space-y-3" role="tablist" aria-label="Decisiones de Arquitectura">
      {adrs.map((adr, index) => (
        <button
          type="button"
          role="tab"
          id={`adr-tab-${index}`}
          aria-controls={`adr-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          data-adr-tab={index}
          class:list={[
            'adr-tab-btn group w-full text-left p-4 rounded-xl border transition-all duration-150 cursor-pointer text-xs',
            index === 0
              ? 'is-active border-accent bg-accent-subtle text-fg shadow-sm ring-1 ring-accent/30'
              : 'border-border bg-surface text-muted hover:border-border-strong hover:bg-surface-muted hover:text-fg'
          ]}
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="font-bold text-accent font-mono">{adr.num}</span>
            <span class="text-[10px] px-2 py-0.5 rounded border border-border bg-surface-muted text-muted font-semibold uppercase">
              <span class="lang-es">{adr.badge.es}</span>
              <span class="lang-en">{adr.badge.en}</span>
            </span>
          </div>
          <h3 class="font-display text-sm font-bold text-fg group-hover:text-accent transition-colors leading-snug">
            <span class="lang-es">{adr.title.es}</span>
            <span class="lang-en">{adr.title.en}</span>
          </h3>
          <p class="text-xs text-muted mt-1 line-clamp-2 leading-relaxed font-medium">
            <span class="lang-es">{adr.summary.es}</span>
            <span class="lang-en">{adr.summary.en}</span>
          </p>
        </button>
      ))}
    </div>

    <!-- COLUMNA DERECHA: INSPECTOR TÉCNICO DETALLADO (7 cols) -->
    <div
      id="adr-inspector-box"
      class="lg:col-span-7 card-editorial p-6 sm:p-8"
    >
      {adrs.map((adr, index) => (
        <div
          id={`adr-panel-${index}`}
          role="tabpanel"
          aria-labelledby={`adr-tab-${index}`}
          data-adr-panel={index}
          class:list={['adr-panel-content space-y-6', index !== 0 && 'hidden']}
        >
          <!-- Encabezado de la Decisión -->
          <div class="border-b border-border pb-4 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <span class="text-accent font-bold"><span class="font-mono">{adr.num}</span> // {adr.system}</span>
              <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full font-semibold text-[11px]">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="lang-es">EN PRODUCCIÓN</span>
                <span class="lang-en">IN PRODUCTION</span>
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold font-display text-fg">
              <span class="lang-es">{adr.title.es}</span>
              <span class="lang-en">{adr.title.en}</span>
            </h3>
            <p class="text-xs sm:text-sm text-muted font-medium">
              <span class="lang-es">{adr.summary.es}</span>
              <span class="lang-en">{adr.summary.en}</span>
            </p>
          </div>

          <!-- Métricas Numéricas de Impacto -->
          <div class="grid grid-cols-3 gap-3 text-center">
            {adr.metrics.map((m) => (
              <div class="card-editorial !rounded-lg bg-surface-muted p-3 space-y-0.5">
                <div class="text-base sm:text-lg font-extrabold text-accent tabular-nums">{m.val}</div>
                <div class="text-xs text-muted leading-tight font-semibold">
                  <span class="lang-es">{m.label.es}</span>
                  <span class="lang-en">{m.label.en}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Bloques: Contexto, Decisión y Trade-offs -->
          <div class="space-y-3.5 text-xs">
            <!-- 01. Contexto -->
            <div class="card-editorial !rounded-xl bg-surface-muted p-4 space-y-1.5">
              <span class="text-muted uppercase tracking-wider font-bold text-[11px] block">
                <span class="lang-es">01. Reto Operativo & Finanzas</span>
                <span class="lang-en">01. Operational & Financial Challenge</span>
              </span>
              <p class="text-muted leading-relaxed font-medium">
                <span class="lang-es">{adr.context.es}</span>
                <span class="lang-en">{adr.context.en}</span>
              </p>
            </div>

            <!-- 02. Decisión Adoptada -->
            <div class="card-editorial !rounded-xl border-accent/40 bg-accent-subtle p-4 space-y-1.5">
              <span class="text-accent uppercase tracking-wider font-bold text-[11px] block">
                <span class="lang-es">02. Decisión de Ingeniería Adoptada</span>
                <span class="lang-en">02. Engineering Decision Adopted</span>
              </span>
              <p class="text-fg whitespace-pre-line text-xs leading-relaxed font-medium">
                <span class="lang-es">{adr.decision.es}</span>
                <span class="lang-en">{adr.decision.en}</span>
              </p>
            </div>

            <!-- 03. Trade-offs -->
            <div class="card-editorial !rounded-xl bg-surface-muted p-4 space-y-1.5">
              <span class="text-muted uppercase tracking-wider font-bold text-[11px] block">
                <span class="lang-es">03. Trade-offs & Mitigación</span>
                <span class="lang-en">03. Trade-offs & Risk Mitigation</span>
              </span>
              <p class="text-muted leading-relaxed font-medium">
                <span class="lang-es">{adr.tradeoffs.es}</span>
                <span class="lang-en">{adr.tradeoffs.en}</span>
              </p>
            </div>
          </div>

          <!-- Acción Directa -->
          <div class="pt-2 flex justify-end">
            <a
              href={adr.actionUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary text-xs font-semibold !py-2"
            >
              <span>
                <span class="lang-es">{adr.actionText.es}</span>
                <span class="lang-en">{adr.actionText.en}</span>
              </span>
              <Icon name="lucide:arrow-up-right" class="size-3.5 text-accent" />
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</Section>

<script>
  function initAdrTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-adr-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-adr-panel]');

    function selectAdr(targetIndex: number) {
      tabs.forEach((tab, idx) => {
        const isActive = idx === targetIndex;
        tab.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          tab.classList.add('is-active', 'border-accent', 'bg-accent-subtle', 'text-fg', 'ring-1', 'ring-accent/30');
          tab.classList.remove('border-border', 'bg-surface', 'text-muted');
        } else {
          tab.classList.remove('is-active', 'border-accent', 'bg-accent-subtle', 'text-fg', 'ring-1', 'ring-accent/30');
          tab.classList.add('border-border', 'bg-surface', 'text-muted');
        }
      });

      panels.forEach((panel, idx) => {
        if (idx === targetIndex) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const index = parseInt(tab.dataset.adrTab || '0', 10);
        selectAdr(index);
      });
    });
  }

  initAdrTabs();
  document.addEventListener('astro:page-load', initAdrTabs);
</script>
