---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { ai } from '../data/cv';

const [productPillar, engineeringPillar] = ai.pillars;

const pipelineSteps = [
  {
    step: '01',
    title: 'Comprobante / Factura',
    desc: 'Ingreso de PDF o imagen de transacción bancaria',
    tag: 'Input',
    icon: 'lucide:file-text',
  },
  {
    step: '02',
    title: 'OCR Tesseract.js',
    desc: 'Extracción instantánea de texto sin coste de API',
    tag: 'Local OCR',
    icon: 'lucide:scan-text',
  },
  {
    step: '03',
    title: 'Claude Vision (Anthropic)',
    desc: 'Inferencia contable inteligente si hay baja resolución o campos omitidos',
    tag: 'LLM Fallback',
    icon: 'lucide:sparkles',
  },
  {
    step: '04',
    title: 'PostgreSQL Validado',
    desc: 'Impacto seguro en base de datos con políticas RLS multi-tenant',
    tag: 'Producción',
    icon: 'lucide:database',
  },
];
---

<Section
  id="ia"
  eyebrow="Inteligencia Artificial Aplicada"
  title="IA en producción & automatización de ingeniería"
  subtitle="Integración pragmática de modelos de lenguaje y visión por computadora en sistemas empresariales, y aceleración del ciclo de entrega mediante agentes autónomos controlados."
>
  <div class="space-y-8">
    
    <!-- Módulo 1: Pipeline de IA en Producto (CryoTech) -->
    <div data-reveal class="glass-card glow-border p-6 sm:p-8 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-line pb-5">
        <div>
          <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-accent uppercase tracking-wider">
            <Icon name="lucide:cpu" class="size-4" />
            <span>Arquitectura en Producto</span>
          </div>
          <h3 class="mt-1 font-display text-xl font-bold text-fg sm:text-2xl">
            {productPillar.title}
          </h3>
        </div>
        <span class="rounded-full border border-line bg-surface-2 px-3 py-1 text-xs font-mono text-muted">
          CryoTech · Producción Real
        </span>
      </div>

      <!-- Pipeline de Datos Interactivo Paso a Paso -->
      <div class="mt-8">
        <div class="flex items-center justify-between mb-4">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-muted">
            Flujo de Ejecución: OCR Híbrido con Inferencia Contable
          </p>
          <span class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-emerald-500">
            <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Pipeline Activo
          </span>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 relative">
          {pipelineSteps.map((step, idx) => (
            <div class="group relative rounded-xl border border-line bg-surface-2/50 p-4 transition-all duration-300 hover:border-accent hover:bg-surface-2 hover:shadow-lg hover:-translate-y-1">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-bold text-accent">{step.step}</span>
                <span class="rounded-md border border-line bg-surface px-1.5 py-0.5 font-mono text-[10px] text-muted group-hover:text-fg">
                  {step.tag}
                </span>
              </div>
              <div class="flex items-center gap-2 font-display text-sm font-bold text-fg mt-2">
                <Icon name={step.icon} class="size-4 text-accent shrink-0" />
                <span>{step.title}</span>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-muted">
                {step.desc}
              </p>

              {idx < pipelineSteps.length - 1 && (
                <div class="hidden lg:block absolute -right-2.5 top-1/2 -translate-y-1/2 z-10 text-muted/60">
                  <Icon name="lucide:chevron-right" class="size-4" />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Otros Módulos de IA en Producto -->
      <div class="mt-6 grid gap-4 sm:grid-cols-2 pt-6 border-t border-line">
        {productPillar.items.slice(1).map((item) => (
          <div class="rounded-xl border border-line bg-surface-2/30 p-4 transition-colors hover:border-line-strong hover:bg-surface-2/60">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-display text-xs font-bold text-fg flex items-center gap-2">
                <Icon name={item.icon} class="size-4 text-accent" />
                {item.title}
              </span>
              <span class="rounded border border-line bg-surface px-2 py-0.5 font-mono text-[10px] text-muted">
                {item.source}
              </span>
            </div>
            <p class="text-xs text-muted leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Módulo 2: IA en el Flujo de Ingeniería & Agentes -->
    <div data-reveal style="--d: 80ms" class="glass-card glow-border p-6 sm:p-8 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-line pb-5">
        <div>
          <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-accent uppercase tracking-wider">
            <Icon name="lucide:bot" class="size-4" />
            <span>Ingeniería Acelerada</span>
          </div>
          <h3 class="mt-1 font-display text-xl font-bold text-fg sm:text-2xl">
            {engineeringPillar.title}
          </h3>
        </div>
        <span class="rounded-full border border-line bg-surface-2 px-3 py-1 text-xs font-mono text-muted">
          CI/CD · Testing · AGENTS.md
        </span>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {engineeringPillar.items.map((item) => (
          <div class="rounded-xl border border-line bg-surface-2/30 p-4 transition-colors hover:border-line-strong hover:bg-surface-2/60 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-display text-xs font-bold text-fg flex items-center gap-2">
                  <Icon name={item.icon} class="size-4 text-accent" />
                  {item.title}
                </span>
                <span class="rounded border border-line bg-surface px-2 py-0.5 font-mono text-[10px] text-muted">
                  {item.source}
                </span>
              </div>
              <p class="text-xs text-muted leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Barra de Ecosistema & Modelos -->
      <div class="mt-6 pt-5 border-t border-line flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <span class="font-mono text-muted uppercase tracking-wider font-semibold">
          Modelos & Herramientas Integradas:
        </span>
        <ul class="flex flex-wrap gap-1.5">
          {ai.tools.map((tool) => (
            <SkillChip skill={tool} size="sm" />
          ))}
        </ul>
      </div>
    </div>

  </div>
</Section>
