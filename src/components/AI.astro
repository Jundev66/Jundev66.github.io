---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { ai } from '../data/cv';

const [productPillar, engineeringPillar] = ai.pillars;
---

<Section
  id="ia"
  eyebrow={{ es: 'Inteligencia Artificial Aplicada', en: 'Applied Artificial Intelligence' }}
  title={{ es: 'IA en Producto & Ecosistemas de Agentes', en: 'Product AI & Agentic Engineering' }}
  subtitle={{
    es: 'Integración pragmática de modelos de lenguaje en plataformas empresariales con control estricto de costes de inferencia, y aceleración del ciclo de entrega mediante agentes gobernados por arquitectura.',
    en: 'Pragmatic language model integration in enterprise software with strict token cost controls, and development acceleration through architecture-governed agents.',
  }}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
    
    <!-- PILAR 1: IA EN PRODUCTO (EFICIENCIA & COSTE CONTROLADO) -->
    <article data-reveal class="card-editorial p-6 sm:p-8 flex flex-col justify-between space-y-6">
      <div class="space-y-6">
        <header class="border-b border-border pb-4 space-y-1">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-accent uppercase tracking-wider">
            <Icon name={productPillar.icon} class="size-4" />
            <span>
              <span class="lang-es">01. En el Producto</span>
              <span class="lang-en">01. Inside the Product</span>
            </span>
          </div>
          <h3 class="font-display text-xl font-bold text-fg sm:text-2xl">
            <span class="lang-es">{productPillar.title.es}</span>
            <span class="lang-en">{productPillar.title.en}</span>
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            <span class="lang-es">{productPillar.subtitle.es}</span>
            <span class="lang-en">{productPillar.subtitle.en}</span>
          </p>
        </header>

        <!-- Lista de Capacidades en Producto -->
        <div class="space-y-4">
          {productPillar.items.map((item) => (
            <div class="card-editorial !rounded-xl bg-surface-muted p-4 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="font-display text-xs font-bold text-fg flex items-center gap-2">
                  <Icon name={item.icon} class="size-3.5 text-accent" />
                  <span>
                    <span class="lang-es">{item.title.es}</span>
                    <span class="lang-en">{item.title.en}</span>
                  </span>
                </span>
                <span class="rounded border border-border bg-surface px-2 py-0.5 text-[10px] font-semibold text-muted">
                  {item.source}
                </span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                <span class="lang-es">{item.text.es}</span>
                <span class="lang-en">{item.text.en}</span>
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="pt-4 border-t border-border text-xs text-muted flex items-center justify-between">
        <span>
          <span class="lang-es">Enfoque: <strong>Ahorro &gt;80% API tokens</strong></span>
          <span class="lang-en">Focus: <strong>&gt;80% Token cost savings</strong></span>
        </span>
        <span class="text-emerald-600 dark:text-emerald-400 font-semibold">CryoTech · CoreBiz</span>
      </div>
    </article>

    <!-- PILAR 2: IA EN INGENIERÍA (AGENTES CON LÍMITES) -->
    <article data-reveal style="--d: 80ms" class="card-editorial p-6 sm:p-8 flex flex-col justify-between space-y-6">
      <div class="space-y-6">
        <header class="border-b border-border pb-4 space-y-1">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-accent uppercase tracking-wider">
            <Icon name={engineeringPillar.icon} class="size-4" />
            <span>
              <span class="lang-es">02. En el Ciclo de Desarrollo</span>
              <span class="lang-en">02. In Dev Workflows</span>
            </span>
          </div>
          <h3 class="font-display text-xl font-bold text-fg sm:text-2xl">
            <span class="lang-es">{engineeringPillar.title.es}</span>
            <span class="lang-en">{engineeringPillar.title.en}</span>
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            <span class="lang-es">{engineeringPillar.subtitle.es}</span>
            <span class="lang-en">{engineeringPillar.subtitle.en}</span>
          </p>
        </header>

        <!-- Lista de Capacidades en Ingeniería -->
        <div class="space-y-4">
          {engineeringPillar.items.map((item) => (
            <div class="card-editorial !rounded-xl bg-surface-muted p-4 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="font-display text-xs font-bold text-fg flex items-center gap-2">
                  <Icon name={item.icon} class="size-3.5 text-accent" />
                  <span>
                    <span class="lang-es">{item.title.es}</span>
                    <span class="lang-en">{item.title.en}</span>
                  </span>
                </span>
                <span class="rounded border border-border bg-surface px-2 py-0.5 text-[10px] font-semibold text-muted">
                  {item.source}
                </span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                <span class="lang-es">{item.text.es}</span>
                <span class="lang-en">{item.text.en}</span>
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Barra de Modelos & Herramientas -->
      <div class="pt-4 border-t border-border space-y-2">
        <span class="block text-xs text-muted uppercase tracking-wider font-bold">
          <span class="lang-es">Herramientas & Modelos:</span>
          <span class="lang-en">Tools & Models:</span>
        </span>
        <ul class="flex flex-wrap gap-1.5">
          {ai.tools.map((tool) => (
            <SkillChip skill={tool} size="sm" />
          ))}
        </ul>
      </div>
    </article>

  </div>
</Section>
