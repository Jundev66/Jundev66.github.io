---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { education } from '../data/cv';
---

<Section id="formacion" eyebrow="Formación" title="Educación, certificaciones e idiomas">
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    <!-- Formación Académica -->
    <article data-reveal class="glass-card p-6 sm:p-7 flex flex-col justify-between shadow-xl">
      <div>
        <span class="grid size-11 place-items-center rounded-xl bg-accent/15 text-accent border border-accent/20">
          <Icon name="lucide:graduation-cap" class="size-5" />
        </span>
        <p class="mt-5 text-xs font-mono font-bold tracking-wider text-muted uppercase">Educación Superior</p>
        <h3 class="mt-2 font-display text-lg font-bold text-fg">{education.degree.title}</h3>
        <p class="mt-1 text-xs text-muted">{education.degree.school}</p>
        <p class="mt-0.5 text-xs text-muted">{education.degree.place}</p>
      </div>
      <div class="mt-6 pt-4 border-t border-line">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 py-1 text-xs font-mono">
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          {education.degree.status}
        </span>
      </div>
    </article>

    <!-- Certificaciones y Especialización -->
    <article data-reveal style="--d: 80ms" class="glass-card p-6 sm:p-7 flex flex-col justify-between shadow-xl">
      <div>
        <span class="grid size-11 place-items-center rounded-xl bg-accent/15 text-accent border border-accent/20">
          <Icon name="lucide:award" class="size-5" />
        </span>
        <p class="mt-5 text-xs font-mono font-bold tracking-wider text-muted uppercase">Especialización & Prácticas</p>
        <ul class="mt-2 space-y-4">
          {education.certifications.map((cert) => (
            <li>
              <h3 class="font-display text-lg font-bold text-fg">{cert.title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-muted">{cert.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="mt-6 pt-4 border-t border-line text-xs font-mono text-muted">
        Buenas prácticas & arquitectura limpia
      </div>
    </article>

    <!-- Idiomas -->
    <article data-reveal style="--d: 160ms" class="glass-card p-6 sm:p-7 md:col-span-2 lg:col-span-1 flex flex-col justify-between shadow-xl">
      <div>
        <span class="grid size-11 place-items-center rounded-xl bg-accent/15 text-accent border border-accent/20">
          <Icon name="lucide:languages" class="size-5" />
        </span>
        <p class="mt-5 text-xs font-mono font-bold tracking-wider text-muted uppercase">Idiomas</p>
        <div class="mt-4 space-y-3">
          {education.languages.map((lang) => (
            <div class="rounded-xl border border-line bg-surface-2/40 p-3 flex items-center justify-between">
              <span class="font-display text-sm font-semibold text-fg">{lang.name}</span>
              <span class="rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-xs text-muted">
                {lang.level}
              </span>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-6 pt-4 border-t border-line text-xs font-mono text-muted">
        Documentación técnica y comunicación
      </div>
    </article>
  </div>
</Section>
