---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { education } from '../data/cv';
---

<Section
  id="formacion"
  eyebrow={{ es: 'Formación & Credenciales', en: 'Education & Credentials' }}
  title={{ es: 'Educación, Certificaciones e Idiomas', en: 'Education, Certifications & Languages' }}
  subtitle={{
    es: 'Base académica sólida en ciencias de la computación, especialización continua en diseño de software y dominio técnico del inglés.',
    en: 'Academic computer science foundation, continuous software craftsmanship specialization, and professional English proficiency.',
  }}
>
  <!-- 1. Formación Superior e Idiomas -->
  <div class="grid gap-6 md:grid-cols-2">
    
    <!-- Formación Universitaria -->
    <article data-reveal class="card-editorial p-6 flex flex-col justify-between">
      <div class="space-y-3">
        <span class="grid size-10 place-items-center rounded-xl bg-accent-subtle text-accent border border-accent-border">
          <Icon name="lucide:graduation-cap" class="size-5" />
        </span>
        <p class="text-xs font-bold tracking-wider text-muted uppercase">
          <span class="lang-es">Educación Superior</span>
          <span class="lang-en">Higher Education</span>
        </p>
        <h3 class="font-display text-base font-bold text-fg">
          <span class="lang-es">{education.degree.title.es}</span>
          <span class="lang-en">{education.degree.title.en}</span>
        </h3>
        <p class="text-xs text-muted font-medium">{education.degree.school} · {education.degree.place}</p>
      </div>

      <div class="mt-6 pt-4 border-t border-border">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-2.5 py-1 text-xs font-semibold text-fg">
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          <span class="lang-es">{education.degree.status.es}</span>
          <span class="lang-en">{education.degree.status.en}</span>
        </span>
      </div>
    </article>

    <!-- Idiomas -->
    <article data-reveal style="--d: 80ms" class="card-editorial p-6 flex flex-col justify-between">
      <div class="space-y-3">
        <span class="grid size-10 place-items-center rounded-xl bg-accent-subtle text-accent border border-accent-border">
          <Icon name="lucide:languages" class="size-5" />
        </span>
        <p class="text-xs font-bold tracking-wider text-muted uppercase">
          <span class="lang-es">Idiomas</span>
          <span class="lang-en">Languages</span>
        </p>
        <div class="space-y-2.5 text-xs">
          {education.languages.map((lang) => (
            <div class="rounded-lg border border-border bg-surface-muted p-3 flex items-center justify-between">
              <span class="font-bold text-fg">
                <span class="lang-es">{lang.name.es}</span>
                <span class="lang-en">{lang.name.en}</span>
              </span>
              <span class="text-accent font-semibold">
                <span class="lang-es">{lang.level.es}</span>
                <span class="lang-en">{lang.level.en}</span>
              </span>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-border text-xs text-muted font-medium">
        <span class="lang-es">Documentación técnica & comunicación</span>
        <span class="lang-en">Technical docs & international teams</span>
      </div>
    </article>

  </div>

  <!-- 2. Certificaciones Profesionales Codely -->
  <div class="mt-8 space-y-5">
    <div data-reveal class="flex items-center justify-between flex-wrap gap-3 pt-2">
      <div class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-xl bg-accent-subtle text-accent border border-accent-border">
          <Icon name="lucide:award" class="size-5" />
        </span>
        <div>
          <p class="text-xs font-bold tracking-wider text-muted uppercase">
            <span class="lang-es">Especialización & Prácticas</span>
            <span class="lang-en">Specialization & Practices</span>
          </p>
          <h3 class="font-display text-base font-bold text-fg">
            <span class="lang-es">Certificaciones Técnicas — Codely</span>
            <span class="lang-en">Technical Certifications — Codely</span>
          </h3>
        </div>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-3 py-1 text-xs font-semibold text-accent">
        <Icon name="lucide:check-circle-2" class="size-3.5 text-emerald-500" />
        <span class="lang-es">7 Certificaciones Verificadas</span>
        <span class="lang-en">7 Verified Certifications</span>
      </span>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {education.codelyCourses.map((c, idx) => (
        <article data-reveal style={`--d: ${(idx + 2) * 40}ms`} class="card-editorial p-5 flex flex-col justify-between hover:border-accent-border/60 transition-colors">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1 rounded bg-accent-subtle px-2 py-0.5 text-[11px] font-semibold text-accent border border-accent-border/50">
                {c.issuer}
              </span>
              <span class="text-[11px] text-muted font-mono flex items-center gap-1">
                <Icon name="lucide:calendar" class="size-3" />
                <span class="lang-es">{c.issueDate.es}</span>
                <span class="lang-en">{c.issueDate.en}</span>
              </span>
            </div>

            <h4 class="font-display text-sm font-bold text-fg leading-snug">
              <span class="lang-es">{c.title.es}</span>
              <span class="lang-en">{c.title.en}</span>
            </h4>

            <div class="flex flex-wrap gap-1.5 pt-1">
              {c.skills.map((skill) => (
                <span class="inline-flex items-center rounded border border-border bg-surface-muted px-2 py-0.5 text-[10px] font-medium text-muted">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs">
            <a
              href={c.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-muted hover:text-accent font-medium transition-colors"
            >
              <span class="lang-es">Temario</span>
              <span class="lang-en">Curriculum</span>
              <Icon name="lucide:external-link" class="size-3" />
            </a>

            <a
              href={c.certificatePdf}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-accent hover:underline font-semibold"
            >
              <Icon name="lucide:file-text" class="size-3" />
              <span class="lang-es">Certificado</span>
              <span class="lang-en">Certificate</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Section>
