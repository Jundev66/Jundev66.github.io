---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { education } from '../data/cv';
---

<Section id="formacion" eyebrow="Formación" title="Educación, certificaciones e idiomas">
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    <article data-reveal class="card card-hover p-6 sm:p-7">
      <span class="grid size-11 place-items-center rounded-xl bg-accent/12 text-accent">
        <Icon name="lucide:graduation-cap" class="size-5" />
      </span>
      <p class="mt-5 text-xs font-semibold tracking-wide text-muted uppercase">Formación académica</p>
      <h3 class="mt-2 font-display text-lg font-semibold">{education.degree.title}</h3>
      <p class="mt-1 text-sm text-muted">{education.degree.school}</p>
      <p class="mt-0.5 text-sm text-muted">{education.degree.place}</p>
      <span class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 py-1 text-xs">
        <span class="size-1.5 rounded-full bg-amber-500"></span>
        {education.degree.status}
      </span>
    </article>

    <article data-reveal style="--d: 80ms" class="card card-hover p-6 sm:p-7">
      <span class="grid size-11 place-items-center rounded-xl bg-accent/12 text-accent">
        <Icon name="lucide:award" class="size-5" />
      </span>
      <p class="mt-5 text-xs font-semibold tracking-wide text-muted uppercase">Certificaciones y formación continua</p>
      <ul class="mt-2 space-y-4">
        {
          education.certifications.map((cert) => (
            <li>
              <h3 class="font-display text-lg font-semibold">{cert.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{cert.text}</p>
            </li>
          ))
        }
      </ul>
    </article>

    <article data-reveal style="--d: 160ms" class="card card-hover p-6 sm:p-7 md:col-span-2 lg:col-span-1">
      <span class="grid size-11 place-items-center rounded-xl bg-accent/12 text-accent">
        <Icon name="lucide:languages" class="size-5" />
      </span>
      <p class="mt-5 text-xs font-semibold tracking-wide text-muted uppercase">Idiomas</p>
      <ul class="mt-3 space-y-5">
        {
          education.languages.map((lang) => (
            <li>
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display font-semibold">{lang.name}</h3>
                <span class="text-sm text-muted">{lang.level}</span>
              </div>
              <div
                class="mt-2 h-1.5 overflow-hidden rounded-full bg-surface-2"
                role="img"
                aria-label={`${lang.name}: ${lang.level}`}
              >
                <div
                  class="h-full rounded-full bg-gradient-to-r from-[var(--btn-from)] to-[var(--btn-to)]"
                  style={`width: ${lang.value}%`}
                />
              </div>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</Section>
