---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { profile } from '../data/cv';

const contactChannels = [
  {
    label: { es: 'Correo Electrónico', en: 'Direct Email' },
    value: profile.email,
    href: `mailto:${profile.email}`,
    icon: 'lucide:mail',
    copy: profile.email,
  },
  {
    label: { es: 'WhatsApp Directo', en: 'Direct WhatsApp' },
    value: profile.whatsapp,
    href: profile.whatsappUrl,
    icon: 'simple-icons:whatsapp',
    color: '#25d366',
    copy: profile.whatsapp,
  },
  {
    label: { es: 'LinkedIn Profesional', en: 'LinkedIn Profile' },
    value: profile.linkedinUser,
    href: profile.linkedin,
    icon: 'simple-icons:linkedin',
    color: '#0a66c2',
  },
  {
    label: { es: 'GitHub Repositorios', en: 'GitHub Profile' },
    value: profile.githubUser,
    href: profile.github,
    icon: 'simple-icons:github',
  },
];
---

<Section
  id="contacto"
  eyebrow={{ es: 'Contacto Directo', en: 'Get in Touch' }}
  title={{ es: 'Construyamos Software de Alto Impacto', en: "Let's Build Resilient Software Together" }}
  subtitle={{
    es: 'Disponible de inmediato para incorporarme a equipos remotos o híbridos que valoren la arquitectura limpia, las pruebas automatizadas y la excelencia operativa.',
    en: 'Immediately available to join remote or hybrid teams that prioritize clean architecture, automated testing, and engineering excellence.',
  }}
>
  <div data-reveal class="card-editorial p-6 sm:p-10 lg:p-12 space-y-8">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      
      <!-- Columna Izquierda: Mensaje & Acciones Principales (7 cols) -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="lang-es">{profile.availability.es}</span>
          <span class="lang-en">{profile.availability.en}</span>
        </div>

        <h3 class="font-display text-2xl sm:text-3xl font-extrabold text-fg tracking-tight">
          <span class="lang-es">¿Tienes un reto técnico o una vacante en tu equipo?</span>
          <span class="lang-en">Have an engineering challenge or an open role?</span>
        </h3>

        <p class="text-sm leading-relaxed text-muted max-w-xl">
          <span class="lang-es">
            Si buscas un desarrollador Full-Stack, Cloud o QA que resuelva problemas de negocio con criterio de arquitectura y suites automatizadas, hablemos directamente.
          </span>
          <span class="lang-en">
            If you are looking for a Full-Stack, Cloud or QA engineer who tackles business requirements with architectural discipline and automated testing, let's talk directly.
          </span>
        </p>

        <!-- Botones de Acción Inmediata -->
        <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-medium">
          <a href={`mailto:${profile.email}`} class="btn btn-primary !px-5 !py-2.5">
            <Icon name="lucide:mail" class="size-4" />
            <span>{profile.email}</span>
          </a>

          <a
            href={profile.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary !px-4 !py-2.5"
          >
            <Icon name="simple-icons:whatsapp" class="size-4 text-emerald-500" />
            <span class="lang-es">WhatsApp</span>
            <span class="lang-en">WhatsApp</span>
          </a>

          <a href={profile.cv} download class="btn btn-secondary !px-4 !py-2.5">
            <Icon name="lucide:file-text" class="size-4 text-accent" />
            <span class="lang-es">Descargar CV</span>
            <span class="lang-en">Download Resume</span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Tarjetas de Canal con Copiado Rápido (5 cols) -->
      <ul class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-1 lg:col-span-5">
        {contactChannels.map((c) => (
          <li class="group flex items-center justify-between rounded-xl border border-border bg-surface-muted p-3 transition-colors hover:border-border-strong hover:bg-surface">
            <a
              href={c.href}
              target={c.href.startsWith('http') ? '_blank' : undefined}
              rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="flex items-center gap-3 min-w-0 flex-1"
            >
              <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-border bg-surface text-fg shadow-2xs">
                <Icon name={c.icon} class="size-4" style={c.color ? `color: ${c.color}` : undefined} />
              </span>
              <div class="min-w-0">
                <span class="block text-[10px] font-semibold text-muted uppercase tracking-wider">
                  <span class="lang-es">{c.label.es}</span>
                  <span class="lang-en">{c.label.en}</span>
                </span>
                <span class="block truncate text-xs font-semibold text-fg group-hover:text-accent transition-colors">
                  {c.value}
                </span>
              </div>
            </a>

            {c.copy ? (
              <button
                type="button"
                class="icon-btn size-8 shrink-0 rounded-md ml-2"
                data-copy={c.copy}
                aria-label={`Copiar ${c.value}`}
                title="Copiar"
              >
                <Icon name="lucide:copy" class="size-3.5" data-copy-icon />
                <Icon name="lucide:check" class="hidden size-3.5 text-emerald-500" data-copied-icon />
              </button>
            ) : (
              <Icon name="lucide:arrow-up-right" class="size-4 text-muted group-hover:text-accent ml-2" />
            )}
          </li>
        ))}
      </ul>

    </div>

    <!-- Pie de Contacto -->
    <div class="text-xs text-muted pt-4 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <span>{profile.location}</span>
      <span class="text-emerald-600 dark:text-emerald-400 font-semibold">
        <span class="lang-es">Respuestas garantizadas en menos de 24 horas</span>
        <span class="lang-en">Replies guaranteed within 24 hours</span>
      </span>
    </div>

  </div>
</Section>

<script>
  function initContactCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
        } catch {
          return;
        }
        const copyIcon = button.querySelector('[data-copy-icon]');
        const copiedIcon = button.querySelector('[data-copied-icon]');
        copyIcon?.classList.add('hidden');
        copiedIcon?.classList.remove('hidden');
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          copiedIcon?.classList.add('hidden');
        }, 1500);
      });
    });
  }

  initContactCopy();
  document.addEventListener('astro:page-load', initContactCopy);
</script>
