---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { profile } from '../data/cv';

const contactMethods = [
  {
    label: 'Correo profesional',
    value: profile.email,
    href: `mailto:${profile.email}`,
    icon: 'lucide:mail',
    copy: profile.email,
  },
  {
    label: 'WhatsApp directo',
    value: profile.whatsapp,
    href: profile.whatsappUrl,
    icon: 'simple-icons:whatsapp',
    color: '#25d366',
    copy: profile.whatsapp,
  },
  {
    label: 'LinkedIn',
    value: profile.linkedinUser,
    href: profile.linkedin,
    icon: 'simple-icons:linkedin',
    color: '#0a66c2',
  },
  {
    label: 'GitHub',
    value: profile.githubUser,
    href: profile.github,
    icon: 'simple-icons:github',
  },
];
---

<Section id="contacto" eyebrow="Contacto Directo" title="Conversemos sobre tu próximo proyecto">
  <div data-reveal class="glass-card glow-border p-6 sm:p-10 shadow-2xl">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      
      <div class="lg:col-span-7">
        <h3 class="font-display text-2xl font-bold tracking-tight text-fg sm:text-3xl">
          Construyamos software robusto juntos
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
          Estoy disponible para incorporarme a equipos remotos o híbridos. Si necesitas un desarrollador Full-Stack con foco en arquitectura limpia, testing riguroso e infraestructura cloud, conversemos.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`mailto:${profile.email}`} class="btn btn-primary">
            <Icon name="lucide:mail" class="size-4" />
            <span>Enviar correo</span>
          </a>
          <a href={profile.cv} download class="btn btn-secondary">
            <Icon name="lucide:download" class="size-4" />
            <span>Descargar CV (PDF)</span>
          </a>
        </div>
      </div>

      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 lg:col-span-5">
        {contactMethods.map((m) => (
          <li class="group flex items-center justify-between rounded-xl border border-line bg-surface-2/40 p-3 transition-colors hover:border-line-strong hover:bg-surface-2/80">
            <a
              href={m.href}
              target={m.href.startsWith('http') ? '_blank' : undefined}
              rel={m.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="flex items-center gap-3 min-w-0 flex-1"
            >
              <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-line bg-surface shadow-xs">
                <Icon name={m.icon} class="size-4" style={m.color ? `color: ${m.color}` : undefined} />
              </span>
              <div class="min-w-0">
                <span class="block text-[11px] font-mono text-muted">{m.label}</span>
                <span class="block truncate font-mono text-xs font-semibold text-fg group-hover:text-accent transition-colors">{m.value}</span>
              </div>
            </a>

            {m.copy ? (
              <button
                type="button"
                class="icon-btn size-8 shrink-0 rounded-md ml-2"
                data-copy={m.copy}
                aria-label={`Copiar ${m.label}`}
                title="Copiar"
              >
                <Icon name="lucide:copy" class="size-3.5" data-copy-icon />
                <Icon name="lucide:check" class="hidden size-3.5 text-emerald-500" data-copied-icon />
              </button>
            ) : (
              <Icon name="lucide:arrow-up-right" class="size-4 text-muted group-hover:text-accent ml-2" />
            )}
          </li>
        ))}
      </ul>

    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
      } catch {
        return;
      }
      const copyIcon = button.querySelector('[data-copy-icon]');
      const copiedIcon = button.querySelector('[data-copied-icon]');
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
      }, 1500);
    });
  });
</script>
