---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { projects } from '../data/cv';
import cryotechLight from '../assets/projects/cryotech-dashboard.png';
import cryotechDark from '../assets/projects/cryotech-dashboard-dark.png';

const tones = {
  amber: 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400',
  emerald: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
};
---

<Section
  id="proyectos"
  eyebrow="Proyectos"
  title="Proyectos personales"
  subtitle="Productos que construyo fuera del trabajo para resolver problemas reales."
>
  <div class="grid gap-6 md:grid-cols-2">
    {
      projects.map((project, i) => (
        <article data-reveal style={`--d: ${i * 90}ms`} class="card card-hover group flex flex-col overflow-hidden">
          <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
            {project.image === 'cryotech' ? (
              <>
                <Image
                  src={cryotechDark}
                  alt="Dashboard de CryoTech en tema oscuro"
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 768px) 560px, 100vw"
                  class="hidden size-full object-cover object-left-top transition-transform duration-500 group-hover:scale-[1.03] dark:block"
                />
                <Image
                  src={cryotechLight}
                  alt="Dashboard de CryoTech en tema claro"
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 768px) 560px, 100vw"
                  class="block size-full object-cover object-left-top transition-transform duration-500 group-hover:scale-[1.03] dark:hidden"
                />
              </>
            ) : (
              <div class="relative grid size-full place-items-center overflow-hidden">
                <div aria-hidden="true" class="bg-grid absolute inset-0 [mask-image:none] opacity-70" />
                <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,var(--glow),transparent_60%)]" />
                <div class="relative flex w-[78%] max-w-sm flex-col gap-2.5 transition-transform duration-500 group-hover:-translate-y-1">
                  {['Negocio A', 'Negocio B', 'Negocio C'].map((business, n) => (
                    <div
                      class="flex items-center justify-between rounded-xl border border-line bg-surface/90 px-4 py-3 shadow-lg backdrop-blur"
                      style={`margin-left: ${n * 1.25}rem`}
                    >
                      <span class="flex items-center gap-2.5 text-sm font-medium">
                        <span class="brand-tile size-7 rounded-lg" style={`--brand: ${['#FF2D20', '#4169E1', '#149ECA'][n]}`}>
                          <Icon name="lucide:layers" class="size-4" />
                        </span>
                        {business}
                      </span>
                      <span class="inline-flex items-center gap-1 font-mono text-[11px] text-muted">
                        <Icon name="lucide:shield-check" class="size-3.5 text-emerald-500" />
                        RLS
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-display text-2xl font-semibold">{project.name}</h3>
                <p class="mt-0.5 text-sm text-muted">{project.subtitle}</p>
              </div>
              <span class:list={['shrink-0 rounded-full border px-2.5 py-1 text-xs font-medium', tones[project.statusTone]]}>
                {project.status}
              </span>
            </div>

            <p class="mt-4 leading-relaxed text-muted">{project.description}</p>

            <ul class="mt-4 space-y-2 text-sm">
              {project.bullets.map((bullet) => (
                <li class="flex gap-2">
                  <Icon name="lucide:check" class="mt-0.5 size-4 shrink-0 text-accent" />
                  <span class="text-muted">{bullet}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-6 flex flex-wrap gap-2 pt-1">
              {project.stack.map((skill) => (
                <SkillChip skill={skill} size="sm" />
              ))}
            </ul>

            {(project.repo || project.demo) && (
              <div class="mt-6 flex flex-wrap gap-3 border-t border-line pt-5">
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary !py-2 text-sm">
                    <Icon name="lucide:external-link" class="size-4" />
                    Ver demo
                  </a>
                )}
                {project.repo && (
                  <a href={project.repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary !py-2 text-sm">
                    <Icon name="simple-icons:github" class="size-4" />
                    Código
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
