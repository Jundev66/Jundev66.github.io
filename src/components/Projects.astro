---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import { projects } from '../data/cv';
import cryotechLight from '../assets/projects/cryotech-dashboard.png';
import cryotechDark from '../assets/projects/cryotech-dashboard-dark.png';

const tones = {
  amber: 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400',
  emerald: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
  sky: 'border-sky-500/30 bg-sky-500/10 text-sky-600 dark:text-sky-400',
};

const tenants = [
  { name: 'Negocio A', color: '#FF2D20' },
  { name: 'Negocio B', color: '#4169E1' },
  { name: 'Negocio C', color: '#149ECA' },
];
---

<Section
  id="proyectos"
  eyebrow="Proyectos"
  title="Proyectos personales"
  subtitle="Productos que construyo fuera del trabajo para resolver problemas reales. El código de todos es público."
>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, i) => {
        const spansTablet = projects.length % 2 === 1 && i === projects.length - 1;
        return (
          <article
            data-reveal
            style={`--d: ${i * 90}ms`}
            class:list={['card card-hover group flex flex-col overflow-hidden', spansTablet && 'md:col-span-2 lg:col-span-1']}
          >
            <div
              class:list={[
                'relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2',
                spansTablet && 'md:max-lg:aspect-[21/9]',
              ]}
            >
              {project.visual === 'cryotech' && (
                <>
                  <Image
                    src={cryotechDark}
                    alt="Dashboard de CryoTech en tema oscuro"
                    widths={[480, 720, 1080]}
                    sizes="(min-width: 1024px) 380px, (min-width: 768px) 700px, 100vw"
                    class="hidden size-full object-cover object-left-top transition-transform duration-500 group-hover:scale-[1.03] dark:block"
                  />
                  <Image
                    src={cryotechLight}
                    alt="Dashboard de CryoTech en tema claro"
                    widths={[480, 720, 1080]}
                    sizes="(min-width: 1024px) 380px, (min-width: 768px) 700px, 100vw"
                    class="block size-full object-cover object-left-top transition-transform duration-500 group-hover:scale-[1.03] dark:hidden"
                  />
                </>
              )}

              {project.visual !== 'cryotech' && (
                <div class="relative grid size-full place-items-center overflow-hidden">
                  <div aria-hidden="true" class="bg-grid absolute inset-0 opacity-70 [mask-image:none]" />
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,var(--glow),transparent_60%)]"
                  />

                  {project.visual === 'tenants' && (
                    <div class="relative flex w-[80%] max-w-sm flex-col gap-2.5 transition-transform duration-500 group-hover:-translate-y-1">
                      {tenants.map((tenant, n) => (
                        <div
                          class="flex items-center justify-between rounded-xl border border-line bg-surface/90 px-3.5 py-2.5 shadow-lg backdrop-blur"
                          style={`margin-left: ${n * 1.1}rem`}
                        >
                          <span class="flex items-center gap-2.5 text-sm font-medium">
                            <span class="brand-tile size-7 rounded-lg" style={`--brand: ${tenant.color}`}>
                              <Icon name="lucide:store" class="size-4" />
                            </span>
                            {tenant.name}
                          </span>
                          <span class="inline-flex items-center gap-1 font-mono text-[11px] text-muted">
                            <Icon name="lucide:shield-check" class="size-3.5 text-emerald-500" />
                            RLS
                          </span>
                        </div>
                      ))}
                    </div>
                  )}

                  {project.visual === 'hexagon' && (
                    <div class="relative aspect-square h-[86%] transition-transform duration-500 group-hover:scale-[1.03]">
                      <div class="absolute inset-0 rounded-full border border-dashed border-line bg-surface/40" />
                      <div class="absolute inset-[17%] rounded-full border border-line bg-surface/80 shadow-lg" />
                      <div class="absolute inset-[35%] grid place-items-center rounded-full bg-gradient-to-br from-[var(--btn-from)] to-[var(--btn-to)] text-white shadow-lg shadow-[var(--glow)]">
                        <Icon name="lucide:hexagon" class="size-[42%]" />
                      </div>
                      <span class="absolute top-[5.5%] left-1/2 -translate-x-1/2 font-mono text-[10px] tracking-wide text-muted">
                        infraestructura
                      </span>
                      <span class="absolute top-[22%] left-1/2 -translate-x-1/2 font-mono text-[10px] tracking-wide text-muted">
                        aplicación
                      </span>
                      <span class="absolute bottom-[23%] left-1/2 -translate-x-1/2 font-mono text-[10px] tracking-wide text-accent">
                        dominio
                      </span>
                    </div>
                  )}
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="font-display text-2xl font-semibold">{project.name}</h3>
                  <p class="mt-0.5 text-sm text-muted">{project.subtitle}</p>
                </div>
                <span class:list={['shrink-0 rounded-full border px-2.5 py-1 text-xs font-medium', tones[project.statusTone]]}>
                  {project.status}
                </span>
              </div>

              <p class="mt-4 leading-relaxed text-muted">{project.description}</p>

              <ul class="mt-4 space-y-2 text-sm">
                {project.bullets.map((bullet) => (
                  <li class="flex gap-2">
                    <Icon name="lucide:check" class="mt-0.5 size-4 shrink-0 text-accent" />
                    <span class="text-muted">{bullet}</span>
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Cifras destacadas">
                {project.metrics.map((metric) => (
                  <li class="rounded-md bg-accent/10 px-2 py-1 font-mono text-[11px] font-medium text-accent">{metric}</li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-2">
                {project.stack.map((skill) => (
                  <SkillChip skill={skill} size="sm" />
                ))}
              </ul>

              {(project.repo || project.demo) && (
                <div class="mt-auto flex flex-wrap gap-3 pt-6">
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary !py-2 text-sm">
                      <Icon name="lucide:external-link" class="size-4" />
                      Ver demo
                    </a>
                  )}
                  {project.repo && (
                    <a
                      href={project.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-secondary !py-2 text-sm"
                      aria-label={`Ver el código de ${project.name} en GitHub`}
                    >
                      <Icon name="simple-icons:github" class="size-4" />
                      Ver código
                      <Icon name="lucide:arrow-up-right" class="size-3.5 opacity-60" />
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Section>
