---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import SkillChip from './SkillChip.astro';
import ProjectLogo from './ProjectLogo.astro';
import { projects } from '../data/cv';
import corebizApp from '../assets/projects/corebiz-app.png';
import cryotechReports from '../assets/projects/cryotech-reports.png';
import cryotechReportsDark from '../assets/projects/cryotech-reports-dark.png';

const komboChannels = [
  { label: 'Portal cliente', icon: 'lucide:globe', desc: 'Catálogo interactivo & checkout' },
  { label: 'Bots WhatsApp/Telegram', icon: 'simple-icons:whatsapp', desc: 'Atención conversacional' },
  { label: 'Punto de venta y caja', icon: 'lucide:receipt', desc: 'Sincronización hacia cocina' },
];
---

<Section
  id="proyectos"
  eyebrow="Ingeniería & Producto"
  title="Sistemas y plataformas en producción"
  subtitle="Arquitecturas completas construidas desde los requerimientos de negocio: aislamiento multi-tenant, DDD táctico, servidores Linux y suites de pruebas automatizadas."
>
  <!-- Selector Interactivo de Proyectos (Tabs) -->
  <div data-reveal class="flex flex-wrap items-center justify-center gap-2 mb-8">
    {projects.map((p, idx) => (
      <button
        type="button"
        data-project-tab={p.logo}
        class:list={[
          'project-tab group flex items-center gap-2.5 rounded-xl border border-line bg-surface/80 px-4 py-2.5 text-xs font-mono font-medium transition-all duration-300 hover:border-accent hover:bg-surface-2 cursor-pointer',
          idx === 0 && 'is-active ring-1 ring-accent border-accent bg-surface-2 text-fg shadow-lg shadow-accent/10'
        ]}
      >
        <ProjectLogo logo={p.logo} name={p.name} class="size-5 rounded-md" />
        <span class="font-bold text-fg group-hover:text-accent transition-colors">{p.name}</span>
        <span class="text-[10px] text-muted hidden sm:inline">· {p.subtitle}</span>
      </button>
    ))}
  </div>

  <!-- Contenedor de Proyectos con Transición Fluida -->
  <div class="relative min-h-[580px]">
    {projects.map((project, idx) => {
      const isLive = project.statusTone === 'emerald';
      return (
        <div
          data-project-panel={project.logo}
          class:list={[
            'project-panel transition-all duration-500 ease-out',
            idx !== 0 && 'hidden opacity-0 translate-y-4'
          ]}
        >
          <article class="glass-card glow-border overflow-hidden p-6 sm:p-8 lg:p-10 shadow-2xl">
            
            <!-- Barra Superior del Proyecto -->
            <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-line pb-6">
              <div class="flex items-center gap-4">
                <ProjectLogo logo={project.logo} name={project.name} class="size-12 rounded-xl shadow-md" />
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <h3 class="font-display text-2xl font-bold text-fg sm:text-3xl">
                      {project.name}
                    </h3>
                    <span class:list={[
                      'inline-flex items-center gap-1.5 rounded-full border px-3 py-0.5 text-xs font-mono font-medium',
                      isLive 
                        ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' 
                        : 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-400'
                    ]}>
                      <span class:list={['size-1.5 rounded-full animate-pulse', isLive ? 'bg-emerald-500' : 'bg-amber-500']} />
                      {project.status}
                    </span>
                  </div>
                  <p class="text-sm text-muted mt-1">{project.subtitle}</p>
                </div>
              </div>

              <!-- Botones de Acción Directa -->
              <div class="flex items-center gap-3">
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    <span>Probar Demo en vivo</span>
                    <Icon name="lucide:arrow-up-right" class="size-4" />
                  </a>
                )}
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-secondary"
                  >
                    <Icon name="simple-icons:github" class="size-4" />
                    <span>Ver Código</span>
                  </a>
                )}
              </div>
            </header>

            <!-- Grid de Contenido: 2 Columnas -->
            <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:gap-10">
              
              <!-- Columna Izquierda: Arquitectura & Retos de Ingeniería (6 cols) -->
              <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
                <div>
                  <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-accent mb-2">
                    Objetivo & Solución Técnica
                  </h4>
                  <p class="text-sm leading-relaxed text-muted sm:text-base">
                    {project.description}
                  </p>

                  <div class="mt-6 space-y-3">
                    <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-fg">
                      Puntos Clave de Arquitectura:
                    </h4>
                    <ul class="space-y-2.5">
                      {project.bullets.map((bullet) => (
                        <li class="flex items-start gap-2.5 text-xs sm:text-sm text-muted leading-relaxed">
                          <Icon name="lucide:check-circle-2" class="size-4 shrink-0 text-accent mt-0.5" />
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Métricas & Stack Utilizado -->
                <div class="space-y-4 pt-6 border-t border-line">
                  <!-- Métricas destacadas con badges -->
                  <div class="flex flex-wrap items-center gap-2">
                    {project.metrics.map((m) => (
                      <span class="rounded-lg border border-line bg-surface-2/80 px-2.5 py-1 font-mono text-xs text-fg font-medium">
                        {m}
                      </span>
                    ))}
                  </div>

                  <!-- Stack con chips -->
                  <ul class="flex flex-wrap gap-1.5 pt-1">
                    {project.stack.map((skill) => (
                      <SkillChip skill={skill} size="sm" />
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Columna Derecha: Vista Previa Visual del Producto (6 cols) -->
              <div class="lg:col-span-6 flex items-center">
                <div class="w-full overflow-hidden rounded-2xl border border-line bg-surface shadow-xl">
                  
                  <!-- Barra simulada de aplicación -->
                  <div class="flex items-center justify-between border-b border-line bg-surface-2/70 px-4 py-2.5 text-xs font-mono text-muted">
                    <div class="flex items-center gap-1.5">
                      <span class="size-2.5 rounded-full bg-red-500/70"></span>
                      <span class="size-2.5 rounded-full bg-amber-500/70"></span>
                      <span class="size-2.5 rounded-full bg-emerald-500/70"></span>
                      <span class="ml-2 font-medium text-fg truncate">
                        {project.demo ? new URL(project.demo).hostname : `${project.name.toLowerCase()}.internal`}
                      </span>
                    </div>
                    <Icon name="lucide:external-link" class="size-3.5 text-muted" />
                  </div>

                  <!-- Capturas reales según el proyecto -->
                  {project.logo === 'corebiz' && (
                    <div class="aspect-[16/10] overflow-hidden bg-surface">
                      <Image
                        src={corebizApp}
                        alt="Pantalla principal de CoreBiz"
                        widths={[480, 720, 1080]}
                        sizes="(min-width: 1024px) 520px, 100vw"
                        class="size-full object-cover transition-transform duration-500 hover:scale-103"
                      />
                    </div>
                  )}

                  {project.logo === 'cryotech' && (
                    <div class="aspect-[16/10] overflow-hidden bg-surface">
                      <Image
                        src={cryotechReports}
                        alt="Panel de Analítica de CryoTech"
                        widths={[540, 800, 1080]}
                        sizes="(min-width: 1024px) 520px, 100vw"
                        class="size-full object-cover dark:hidden transition-transform duration-500 hover:scale-103"
                      />
                      <Image
                        src={cryotechReportsDark}
                        alt="Panel de Analítica de CryoTech en modo oscuro"
                        widths={[540, 800, 1080]}
                        sizes="(min-width: 1024px) 520px, 100vw"
                        class="size-full object-cover hidden dark:block transition-transform duration-500 hover:scale-103"
                      />
                    </div>
                  )}

                  {project.logo === 'kombo' && (
                    <div class="p-6 space-y-4 bg-surface">
                      <p class="text-xs font-mono uppercase tracking-wider text-muted font-bold">
                        Arquitectura Multi-Canal Sincronizada en Tiempo Real:
                      </p>
                      <div class="space-y-2.5">
                        {komboChannels.map((ch) => (
                          <div class="flex items-center gap-3 rounded-xl border border-line bg-surface-2/60 p-3 transition-transform hover:scale-102">
                            <Icon name={ch.icon} class="size-5 text-accent shrink-0" />
                            <div class="min-w-0">
                              <p class="font-display text-xs font-bold text-fg">{ch.label}</p>
                              <p class="text-xs text-muted truncate">{ch.desc}</p>
                            </div>
                          </div>
                        ))}
                      </div>
                      <div class="rounded-xl border border-line bg-surface-2/40 p-3 text-center font-mono text-xs text-muted">
                        Colas asíncronas en Redis · Contenedores Docker en Linux
                      </div>
                    </div>
                  )}

                </div>
              </div>

            </div>

          </article>
        </div>
      );
    })}
  </div>
</Section>

<script>
  // Script para alternar proyectos dinámicamente con animación fluida
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-project-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-project-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.dataset.projectTab;

      // Actualizar estilos de tabs
      tabs.forEach((t) => {
        t.classList.remove('is-active', 'ring-1', 'ring-accent', 'border-accent', 'bg-surface-2', 'shadow-lg');
      });
      tab.classList.add('is-active', 'ring-1', 'ring-accent', 'border-accent', 'bg-surface-2', 'shadow-lg');

      // Actualizar paneles con animación de fade y slide
      panels.forEach((panel) => {
        if (panel.dataset.projectPanel === targetId) {
          panel.classList.remove('hidden');
          // Pequeño timeout para activar la transición CSS
          setTimeout(() => {
            panel.classList.remove('opacity-0', 'translate-y-4');
          }, 20);
        } else {
          panel.classList.add('opacity-0', 'translate-y-4');
          setTimeout(() => {
            panel.classList.add('hidden');
          }, 250);
        }
      });
    });
  });
</script>
