---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import photo from '../assets/juan-mata.png';
import { profile } from '../data/cv';

const heroBadges = [
  { name: 'Node.js', icon: 'simple-icons:nodedotjs', color: '#5FA04E' },
  { name: 'NestJS', icon: 'simple-icons:nestjs', color: '#E0234E' },
  { name: 'Next.js', icon: 'simple-icons:nextdotjs' },
  { name: 'Laravel', icon: 'simple-icons:laravel', color: '#FF2D20' },
  { name: 'React', icon: 'simple-icons:react', color: '#149ECA' },
  { name: 'Linux / DigitalOcean', icon: 'simple-icons:digitalocean', color: '#0080FF' },
  { name: 'Supabase RLS', icon: 'simple-icons:supabase', color: '#3ECF8E' },
  { name: 'Playwright QA', icon: 'simple-icons:playwright', color: '#2EAD33' },
];

const metrics = [
  { value: '4+', label: 'Años en B2B', icon: 'lucide:briefcase' },
  { value: '500+', label: 'Tests en CI/CD', icon: 'lucide:shield-check' },
  { value: '15–20', label: 'Devs en Scrum', icon: 'lucide:users' },
  { value: '100%', label: 'Ciclo completo', icon: 'lucide:layers' },
];
---

<section id="inicio" class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
      
      <!-- Columna Izquierda: Pitch, Credenciales & Acciones (7 cols) -->
      <div class="lg:col-span-7">
        
        <!-- Badges de Disponibilidad & Ex-Medine -->
        <div data-reveal class="flex flex-wrap items-center gap-2">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-mono font-medium text-emerald-700 dark:text-emerald-300 backdrop-blur-md shadow-xs">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            <span>{profile.availability}</span>
          </div>

          <div class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2/80 px-3 py-1 text-xs font-mono text-muted backdrop-blur-md">
            <Icon name="lucide:building-2" class="size-3 text-accent" />
            <span>Ex-Medine.tech (2022–2026 · 4 años)</span>
          </div>
        </div>

        <!-- Nombre Principal con Tipografía de Alto Impacto -->
        <h1
          data-reveal
          style="--d: 80ms"
          class="mt-4 font-display text-4xl font-extrabold tracking-tight text-fg sm:text-5xl lg:text-6xl"
        >
          {profile.name}
        </h1>

        <!-- Rol con Gradiente Futurista -->
        <p
          data-reveal
          style="--d: 140ms"
          class="mt-2 text-xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 dark:from-sky-400 dark:via-indigo-300 dark:to-cyan-400 sm:text-2xl"
        >
          {profile.role}
        </p>

        <!-- Propuesta de Valor / Tagline -->
        <p
          data-reveal
          style="--d: 200ms"
          class="mt-5 text-base leading-relaxed text-muted sm:text-lg max-w-xl"
        >
          {profile.tagline}
        </p>

        <!-- Píldoras de Stack Activo con Micro-interacciones -->
        <div data-reveal style="--d: 260ms" class="mt-6 flex flex-wrap items-center gap-2">
          {heroBadges.map((badge) => (
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface/80 px-2.5 py-1 text-xs font-mono font-medium text-fg backdrop-blur-sm transition-all duration-200 hover:scale-105 hover:border-accent shadow-2xs">
              <Icon name={badge.icon} class="size-3.5 shrink-0" style={badge.color ? `color: ${badge.color}` : undefined} />
              <span>{badge.name}</span>
            </span>
          ))}
        </div>

        <!-- Botones de Acción Primarios & Redes -->
        <div data-reveal style="--d: 320ms" class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#proyectos" class="btn btn-primary">
            <Icon name="lucide:sparkles" class="size-4" />
            <span>Explorar Proyectos</span>
          </a>

          <a href={profile.cv} download class="btn btn-secondary">
            <Icon name="lucide:download" class="size-4" />
            <span>Descargar CV (PDF)</span>
          </a>

          <!-- Iconos de Contacto Rápido -->
          <div class="flex items-center gap-2 sm:ml-2">
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="GitHub de Juan Mata"
              title="GitHub"
            >
              <Icon name="simple-icons:github" class="size-4" />
            </a>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="LinkedIn de Juan Mata"
              title="LinkedIn"
            >
              <Icon name="simple-icons:linkedin" class="size-4 text-[#0a66c2]" />
            </a>
            <a
              href={profile.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="WhatsApp de Juan Mata"
              title="WhatsApp"
            >
              <Icon name="simple-icons:whatsapp" class="size-4 text-[#25d366]" />
            </a>
            <a
              href={`mailto:${profile.email}`}
              class="icon-btn"
              aria-label="Enviar correo a Juan Mata"
              title="Correo"
            >
              <Icon name="lucide:mail" class="size-4" />
            </a>
          </div>
        </div>

      </div>

      <!-- Columna Derecha: Tarjeta HUD Tecnológica con Retrato & Telemetría (5 cols) -->
      <div data-reveal style="--d: 180ms" class="lg:col-span-5">
        <div class="glass-card glow-border overflow-hidden p-4 sm:p-5 shadow-2xl">
          
          <!-- Encabezado de la Tarjeta HUD -->
          <div class="flex items-center justify-between border-b border-line pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-mono text-xs font-semibold text-fg">Sistemas & Cloud</span>
            </div>
            <div id="local-time" class="font-mono text-[11px] text-muted">
              Caracas, VE
            </div>
          </div>

          <!-- Marco del Retrato con Acabado de Precisión -->
          <div class="group relative aspect-[4/3] w-full overflow-hidden rounded-xl border border-line bg-surface-2">
            <Picture
              src={photo}
              alt={`Retrato de ${profile.name}`}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 420px, 320px"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={92}
              loading="eager"
              fetchpriority="high"
              class="size-full object-cover transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Chip flotante sobre la imagen -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between rounded-lg border border-black/20 bg-black/75 px-3 py-1.5 font-mono text-[11px] text-white shadow-lg backdrop-blur-md">
              <span class="flex items-center gap-1.5">
                <Icon name="lucide:shield-check" class="size-3 text-sky-400" />
                <span>Full-Stack & QA</span>
              </span>
              <span class="text-emerald-400 font-bold">Medine.tech</span>
            </div>
          </div>

          <!-- Módulo de Métricas Rápidas en Grid -->
          <div class="mt-4 grid grid-cols-2 gap-2 font-mono text-xs">
            {metrics.map((m) => (
              <div class="flex items-center gap-2 rounded-xl border border-line bg-surface-2/60 p-2.5">
                <Icon name={m.icon} class="size-4 text-accent shrink-0" />
                <div>
                  <span class="block font-bold text-fg leading-none">{m.value}</span>
                  <span class="block text-[10px] text-muted mt-0.5">{m.label}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Reloj local en tiempo real de Caracas (UTC-4)
  const timeEl = document.getElementById('local-time');
  if (timeEl) {
    const updateTime = () => {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('es-VE', {
        timeZone: 'America/Caracas',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
      timeEl.textContent = `Caracas · ${timeStr}`;
    };
    updateTime();
    setInterval(updateTime, 1000);
  }
</script>
