---
import { Icon } from 'astro-icon/components';
import type { Skill } from '../data/cv';

interface Props {
  skill: Skill;
  size?: 'sm' | 'md';
}

const { skill, size = 'sm' } = Astro.props;
---

<li
  class:list={[
    'inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface-muted transition-all duration-150 hover:border-border-strong hover:bg-surface hover:-translate-y-0.5 shadow-2xs',
    size === 'md' ? 'px-3 py-1.5 text-xs font-semibold text-fg' : 'px-2.5 py-1 text-xs text-muted hover:text-fg font-medium',
  ]}
>
  <Icon
    name={skill.icon}
    class={size === 'md' ? 'size-3.5 shrink-0' : 'size-3 shrink-0'}
    style={skill.color ? `color: ${skill.color}` : undefined}
    aria-hidden="true"
  />
  <span class="truncate">{skill.name}</span>
</li>
