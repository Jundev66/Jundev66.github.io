---
import type { Project } from '../data/cv';

interface Props {
  logo: Project['logo'];
  name: string;
  class?: string;
}

const { logo, name, class: className } = Astro.props;

// Mismo sistema para todos: cuadro redondeado con degradado y glifo blanco de trazo 2.
const gradients: Record<Project['logo'], [string, string]> = {
  corebiz: ['#4f46e5', '#7c3aed'],
  kombo: ['#f97316', '#e11d48'],
  cryotech: ['#14b8a6', '#0891b2'],
};

const [from, to] = gradients[logo];
const gradientId = `project-logo-${logo}`;
---

<svg
  viewBox="0 0 48 48"
  role="img"
  aria-label={`Logo de ${name}`}
  class:list={['size-12 shrink-0 rounded-2xl shadow-lg shadow-black/15', className]}
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={from} />
      <stop offset="1" stop-color={to} />
    </linearGradient>
  </defs>
  <rect width="48" height="48" rx="14" fill={`url(#${gradientId})`} />

  <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {
      logo === 'corebiz' && (
        <>
          {/* Capas de un negocio alrededor de un núcleo */}
          <path d="M24 11 37 18 24 25 11 18Z" fill="#fff" fill-opacity="0.28" />
          <path d="M11 24.5 24 31.5 37 24.5" />
          <path d="M11 30.5 24 37.5 37 30.5" stroke-opacity="0.7" />
          <circle cx="24" cy="18" r="2" fill="#fff" stroke="none" />
        </>
      )
    }
    {
      logo === 'kombo' && (
        <>
          {/* Bol de comida con vapor: pedido listo en cocina */}
          <path d="M11.5 25h25a12.5 12.5 0 0 1-25 0Z" fill="#fff" fill-opacity="0.28" />
          <path d="M19 39.5h10" />
          <path d="M20 20.5c-1.6-2 1.6-3.6 0-5.6" />
          <path d="M28 20.5c-1.6-2 1.6-3.6 0-5.6" />
          <path d="M24 19c-1.2-1.5 1.2-2.7 0-4.2" stroke-opacity="0.7" />
        </>
      )
    }
    {
      logo === 'cryotech' && (
        <>
          {/* Cristal hexagonal con facetas */}
          <path d="M24 10.5 35.7 17.25v13.5L24 37.5 12.3 30.75v-13.5Z" />
          <path d="M24 10.5 35.7 17.25 24 24Z" fill="#fff" fill-opacity="0.28" stroke="none" />
          <path d="M24 10.5V24M12.3 17.25 24 24l11.7-6.75" stroke-opacity="0.6" stroke-width="1.5" />
          <circle cx="24" cy="24" r="2.4" fill="#fff" stroke="none" />
        </>
      )
    }
  </g>
</svg>
