---
import type { Project } from '../data/cv';

interface Props {
  logo: Project['logo'];
  name: string;
  class?: string;
}

const { logo, name, class: className = 'size-12' } = Astro.props;
const gradientId = `project-logo-${logo}`;
---

<svg
  viewBox="0 0 32 32"
  role="img"
  aria-label={`Logo de ${name}`}
  class:list={['shrink-0 rounded-[25%] shadow-lg shadow-black/20', className]}
>
  {
    logo === 'corebiz' && (
      <>
        {/* Logo oficial de CoreBiz (apps/web/app/icon.svg en su repo) */}
        <rect width="32" height="32" rx="8" fill="#4f46e5" />
        <path d="M20.6 11.4a6.6 6.6 0 1 0 0 9.2" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
        <circle cx="22.6" cy="16" r="1.9" fill="#fff" />
      </>
    )
  }
  {
    logo === 'cryotech' && (
      <>
        {/* Cristal hexagonal de la app de CryoTech, como icono con su primario */}
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#00a081" />
            <stop offset="1" stop-color="#007b5f" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="8" fill={`url(#${gradientId})`} />
        <g transform="translate(16 16) scale(0.64) translate(-16 -16)" fill="none" stroke="#fff" stroke-linejoin="round">
          <path d="M16 2 28 9 16 16Z" fill="#fff" fill-opacity="0.2" stroke="none" />
          <path d="M16 2V16M4 9 16 16M28 9 16 16" stroke-width="2" stroke-opacity="0.5" />
          <path d="M16 2 28 9V23L16 30 4 23V9Z" stroke-width="3" />
          <circle cx="16" cy="16" r="2.8" fill="#fff" stroke="none" />
        </g>
      </>
    )
  }
  {
    logo === 'kombo' && (
      <>
        {/* Identidad nueva: bol con vapor en el verde de Kombo y el punto naranja de su acento */}
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2f855a" />
            <stop offset="1" stop-color="#1f6f4a" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="8" fill={`url(#${gradientId})`} />
        <path d="M7 17.5h18a9 9 0 0 1-18 0Z" fill="#fff" />
        <g fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-opacity="0.9">
          <path d="M11.5 14c-1.6-1.8 1.6-3.4 0-5.4" />
          <path d="M16 14c-1.8-2.2 1.8-4.2 0-6.8" />
          <path d="M20.5 14c-1.6-1.8 1.6-3.4 0-5.4" />
        </g>
        <circle cx="16" cy="22" r="1.9" fill="#e8783c" />
      </>
    )
  }
</svg>
