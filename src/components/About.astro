---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { about } from '../data/cv';
---

<Section id="sobre-mi" eyebrow="Sobre mí" title="Resumen profesional">
  <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
    <div data-reveal class="space-y-5 text-base leading-relaxed text-muted sm:text-lg">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        about.highlights.map((item, i) => (
          <li data-reveal style={`--d: ${i * 70}ms`} class="card card-hover p-5">
            <span class="grid size-10 place-items-center rounded-xl bg-accent/12 text-accent">
              <Icon name={item.icon} class="size-5" />
            </span>
            <h3 class="mt-4 font-display font-semibold">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <dl class="mt-14 grid grid-cols-2 overflow-hidden rounded-[1.25rem] border border-line bg-line gap-px lg:grid-cols-4">
    {
      about.stats.map((stat, i) => (
        <div data-reveal style={`--d: ${i * 70}ms`} class="bg-surface px-5 py-7 sm:px-7">
          <dt class="text-sm text-muted">{stat.label}</dt>
          <dd class="order-first font-display text-3xl font-bold tracking-tight sm:text-4xl">
            <span class="text-gradient">{stat.value}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
