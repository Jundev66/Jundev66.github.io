---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { about } from '../data/cv';

const pillars = [
  {
    icon: 'lucide:boxes',
    title: 'Arquitectura Limpia & DDD',
    text: 'Domain-Driven Design (DDD), patrones hexagonales y separación estricta de capas para sistemas mantenibles y desacoplados sin tiempo de inactividad.',
    color: 'text-indigo-500 bg-indigo-500/10 border-indigo-500/20',
  },
  {
    icon: 'lucide:server',
    title: 'Servidores Linux & Cloud Ops',
    text: 'Administración de servidores Linux en DigitalOcean, proxies Nginx, contenedores Docker, CI/CD en GitHub Actions y plataformas con Vercel y Supabase.',
    color: 'text-sky-500 bg-sky-500/10 border-sky-500/20',
  },
  {
    icon: 'lucide:shield-check',
    title: 'QA Automatizado & Seguridad',
    text: 'Más de 500 pruebas automatizadas en CI con Playwright (E2E), Vitest, Behat y PHPUnit, junto a auditorías de vulnerabilidades con OWASP ZAP.',
    color: 'text-emerald-500 bg-emerald-500/10 border-emerald-500/20',
  },
  {
    icon: 'lucide:users',
    title: 'Gestión Ágil & Scrum',
    text: 'Coordinación diaria de sprints, historias y bugs en Jira, Linear y Zoho (CRM/Desk) en equipos Scrum multidisciplinarios de 15 a 20 ingenieros.',
    color: 'text-purple-500 bg-purple-500/10 border-purple-500/20',
  },
];
---

<Section id="sobre-mi" eyebrow="Sobre mí" title="Ingeniería de software & arquitectura de entrega">
  <div class="space-y-8">
    
    <!-- Bloque Bento Principal: Narrativa y Métricas -->
    <div class="grid gap-6 lg:grid-cols-12">
      
      <!-- Narrativa (7 cols) -->
      <div data-reveal class="glass-card glow-border p-6 sm:p-8 lg:col-span-7 flex flex-col justify-between shadow-xl">
        <div>
          <div class="flex items-center gap-2 font-mono text-xs text-accent uppercase tracking-wider mb-4 font-bold">
            <Icon name="lucide:terminal" class="size-4" />
            <span>Perfil Técnico & Metodología</span>
          </div>
          <div class="space-y-4 text-sm sm:text-base leading-relaxed text-muted">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-line flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="rounded-lg border border-purple-500/30 bg-purple-500/10 px-2.5 py-1 text-purple-700 dark:text-purple-300">
            Jira & Linear Sprints
          </span>
          <span class="rounded-lg border border-sky-500/30 bg-sky-500/10 px-2.5 py-1 text-sky-700 dark:text-sky-300">
            Servidores Linux & Cloud
          </span>
          <span class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-emerald-700 dark:text-emerald-300">
            Supabase RLS Multi-tenant
          </span>
        </div>
      </div>

      <!-- Métricas Clave de Impacto (5 cols) -->
      <div data-reveal style="--d: 80ms" class="glass-card p-6 lg:col-span-5 flex flex-col justify-between shadow-xl">
        <div>
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-muted mb-4 flex items-center justify-between">
            <span>Métricas en Producción</span>
            <Icon name="lucide:activity" class="size-4 text-accent" />
          </h3>

          <div class="grid grid-cols-2 gap-3 font-mono">
            {about.stats.map((stat) => (
              <div class="rounded-xl border border-line bg-surface-2/60 p-4 transition-transform hover:scale-102">
                <span class="block font-display text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-sky-400 dark:to-indigo-300">
                  {stat.value}
                </span>
                <span class="block mt-1 text-xs text-muted leading-tight">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-line font-mono text-xs text-muted flex items-center justify-between">
          <span>Medine.tech · 2022–2026</span>
          <span class="text-emerald-500 flex items-center gap-1">
            <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Verificado
          </span>
        </div>
      </div>

    </div>

    <!-- 4 Pilares de Práctica Técnica -->
    <div class="grid gap-4 sm:grid-cols-2">
      {pillars.map((item, i) => (
        <div data-reveal style={`--d: ${100 + i * 40}ms`} class="glass-card p-5 sm:p-6 flex items-start gap-4 transition-all hover:-translate-y-1">
          <span class:list={['grid size-10 shrink-0 place-items-center rounded-xl border', item.color]}>
            <Icon name={item.icon} class="size-5" />
          </span>
          <div>
            <h4 class="font-display text-sm font-bold text-fg">{item.title}</h4>
            <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-muted">{item.text}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</Section>
