---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { about } from '../data/cv';

const pillars = [
  {
    icon: 'lucide:boxes',
    title: { es: 'Arquitectura Limpia & DDD', en: 'Clean Architecture & DDD' },
    text: {
      es: 'Domain-Driven Design (DDD), patrones hexagonales y desacoplamiento estricto para sistemas escalables con cero tiempo de inactividad.',
      en: 'Domain-Driven Design (DDD), hexagonal patterns, and decoupled boundaries for maintainable software with zero downtime.',
    },
  },
  {
    icon: 'lucide:server',
    title: { es: 'Servidores Linux & Cloud Ops', en: 'Linux Servers & Cloud Ops' },
    text: {
      es: 'Administración de servidores Linux (DigitalOcean, Ubuntu), proxies Nginx, Docker, GitHub Actions y plataformas serverless (Vercel, Supabase).',
      en: 'Linux server administration (DigitalOcean, Ubuntu), Nginx reverse proxies, Docker, GitHub Actions CI/CD, and serverless stacks (Vercel, Supabase).',
    },
  },
  {
    icon: 'lucide:shield-check',
    title: { es: 'QA Automatizado & Seguridad', en: 'Automated QA & Security' },
    text: {
      es: 'Más de 500 pruebas automatizadas en CI (Playwright E2E con POM, Vitest, Behat, PHPUnit) junto a auditorías continuas con OWASP ZAP.',
      en: '500+ automated tests in CI (Playwright E2E with POM, Vitest, Behat, PHPUnit) along with continuous OWASP ZAP vulnerability triage.',
    },
  },
  {
    icon: 'lucide:users',
    title: { es: 'Gestión Ágil & Scrum', en: 'Agile & Scrum Delivery' },
    text: {
      es: 'Coordinación diaria de sprints, historias de usuario y bugs en Jira, Linear y Zoho en equipos Scrum de 15 a 20 ingenieros.',
      en: 'Daily coordination of sprints, user stories, and bug tracking in Jira, Linear, and Zoho across Scrum teams of 15 to 20 engineers.',
    },
  },
];
---

<Section
  id="sobre-mi"
  eyebrow={{ es: 'Filosofía & Práctica', en: 'Philosophy & Practice' }}
  title={{ es: 'Enfoque Técnico y Metodología', en: 'Technical Focus & Methodology' }}
  subtitle={{
    es: 'Cómo abordo el ciclo de vida del software: desde la comprensión de las reglas del negocio hasta la resiliencia en servidores de producción.',
    en: 'How I approach the software lifecycle: from understanding business domain rules to operational resilience in production.',
  }}
>
  <div class="space-y-8">
    
    <!-- Bloque Principal: Narrativa de Juan -->
    <div class="card-editorial p-6 sm:p-8 lg:p-10 space-y-6">
      <div class="flex items-center gap-2 text-xs text-accent uppercase tracking-wider font-bold">
        <Icon name="lucide:terminal" class="size-4" />
        <span>
          <span class="lang-es">Trayectoria & Enfoque de Entrega</span>
          <span class="lang-en">Track Record & Delivery Approach</span>
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm leading-relaxed text-muted">
        <div class="space-y-4">
          <p>
            <span class="lang-es">{about.paragraphs.es[0]}</span>
            <span class="lang-en">{about.paragraphs.en[0]}</span>
          </p>
          <p>
            <span class="lang-es">{about.paragraphs.es[1]}</span>
            <span class="lang-en">{about.paragraphs.en[1]}</span>
          </p>
        </div>
        <div class="space-y-4">
          <p>
            <span class="lang-es">{about.paragraphs.es[2]}</span>
            <span class="lang-en">{about.paragraphs.en[2]}</span>
          </p>
          <p>
            <span class="lang-es">{about.paragraphs.es[3]}</span>
            <span class="lang-en">{about.paragraphs.en[3]}</span>
          </p>
        </div>
      </div>

      <div class="pt-4 border-t border-border flex flex-wrap items-center gap-2 text-xs font-semibold">
        <span class="rounded-lg border border-border bg-surface-muted px-2.5 py-1 text-fg">
          Jira & Linear Sprints
        </span>
        <span class="rounded-lg border border-border bg-surface-muted px-2.5 py-1 text-fg">
          Linux Servers (DigitalOcean)
        </span>
        <span class="rounded-lg border border-border bg-surface-muted px-2.5 py-1 text-fg">
          Supabase RLS Multi-tenant
        </span>
        <span class="rounded-lg border border-border bg-surface-muted px-2.5 py-1 text-fg">
          Playwright + Vitest + PHPUnit
        </span>
      </div>
    </div>

    <!-- 4 Pilares de Práctica -->
    <div class="grid gap-4 sm:grid-cols-2">
      {pillars.map((item, i) => (
        <div
          data-reveal
          style={`--d: ${i * 40}ms`}
          class="card-editorial p-5 sm:p-6 flex items-start gap-4"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl border border-border bg-surface-muted text-accent">
            <Icon name={item.icon} class="size-5" />
          </span>
          <div class="space-y-1">
            <h4 class="font-display text-sm font-bold text-fg">
              <span class="lang-es">{item.title.es}</span>
              <span class="lang-en">{item.title.en}</span>
            </h4>
            <p class="text-xs leading-relaxed text-muted">
              <span class="lang-es">{item.text.es}</span>
              <span class="lang-en">{item.text.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</Section>
